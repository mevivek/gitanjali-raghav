---
import { work, study } from '../data/work';
---

<section class="work" aria-labelledby="work-heading">
  <div class="wrap">
    <header class="work__header">
      <h2 id="work-heading">The day job</h2>
      <p>The short version. Ask me about any of it.</p>
    </header>

    <ol class="list">
      {
        work.map((job) => (
          <li class="row" data-current={job.current ? 'true' : undefined}>
            <p class="row__years">{job.years}</p>
            <div class="row__what">
              <h3 class="row__role">
                {job.role}
                {job.current && <span class="badge">now</span>}
              </h3>
              <p class="row__company">
                {job.company}
                {job.note && <span class="row__note"> · {job.note}</span>}
              </p>
            </div>
          </li>
        ))
      }
    </ol>

    {
      study.length > 0 && (
        <>
          <h3 class="sub">Before that</h3>
          <ol class="list">
            {study.map((s) => (
              <li class="row">
                <p class="row__years">{s.years}</p>
                <div class="row__what">
                  {/* Subject leads when known; otherwise the institution
                      stands alone rather than showing an empty heading. */}
                  <h4 class="row__role">{s.what ?? s.where}</h4>
                  {s.what && <p class="row__company">{s.where}</p>}
                </div>
              </li>
            ))}
          </ol>
        </>
      )
    }
  </div>
</section>

<style>
  .work {
    padding-block: var(--section-gap);
  }

  .work__header h2 {
    font-size: var(--step-4);
    margin: 0 0 0.35rem;
  }

  .work__header p {
    margin: 0 0 2.5rem;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
  }

  .sub {
    font-family: var(--font-sans);
    font-size: var(--step--1);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--ink-muted);
    margin: 3rem 0 1.25rem;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  .row {
    display: grid;
    gap: 0.15rem 2rem;
    padding-block: 1.4rem;
    border-top: 1px solid var(--rule);
    align-items: baseline;
  }

  .row:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .row__years {
    margin: 0;
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
    text-transform: uppercase;
    font-weight: 600;
  }

  .row[data-current='true'] .row__years {
    color: var(--career-text);
  }

  .row__role {
    margin: 0;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1.25;
  }

  .row__company {
    margin: 0.2rem 0 0;
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .row__note {
    font-size: var(--step--1);
  }

  .badge {
    display: inline-block;
    vertical-align: middle;
    margin-inline-start: 0.6rem;
    font-family: var(--font-sans);
    font-size: 0.68em;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--paper);
    background-color: var(--life);
    border-radius: 999px;
    padding: 0.15em 0.65em;
    /* Nudges the pill off the baseline so it sits with the cap height. */
    transform: translateY(-0.15em);
  }

  @media (min-width: 40rem) {
    .row {
      grid-template-columns: 11rem 1fr;
    }
  }
</style>
