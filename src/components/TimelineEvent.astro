---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'timeline'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { lane, title, org, dateLabel, image, imageAlt } = entry.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<article class="event" data-lane={lane} data-animate>
  <h3 class="event__title">{title}</h3>

  {
    (org || dateLabel) && (
      <p class="event__meta">
        {org && <span class="event__org">{org}</span>}
        {org && dateLabel && <span aria-hidden="true"> · </span>}
        {dateLabel && <span>{dateLabel}</span>}
      </p>
    )
  }

  {
    image && (
      <img
        class="event__image"
        src={`${base}/img/${image}`}
        alt={imageAlt}
        loading="lazy"
        decoding="async"
        width="640"
        height="480"
      />
    )
  }

  <div class="event__body">
    <Content />
  </div>
</article>

<style>
  .event {
    background-color: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    padding: clamp(1rem, 0.85rem + 0.75vw, 1.5rem);
    /* The lane's colour enters as a thick edge rather than a wash, so the
       card stays legible while the lane stays instantly identifiable. */
    border-inline-start: 4px solid var(--lane-colour);
    box-shadow: 0 1px 2px rgb(0 0 0 / 4%);
  }

  .event[data-lane='career'] {
    --lane-colour: var(--career);
    --lane-text: var(--career-text);
  }

  .event[data-lane='life'] {
    --lane-colour: var(--life);
    --lane-text: var(--life-text);
  }

  .event__title {
    font-size: var(--step-1);
    font-weight: 600;
    margin: 0;
    color: var(--ink);
  }

  .event__meta {
    margin: 0.35rem 0 0;
    font-size: var(--step--1);
    color: var(--lane-text);
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .event__org {
    font-weight: 600;
  }

  .event__image {
    margin-top: 0.9rem;
    border-radius: 0.5rem;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .event__body {
    margin-top: 0.75rem;
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .event__body :global(p) {
    margin: 0 0 0.75rem;
  }

  .event__body :global(p:last-child) {
    margin-bottom: 0;
  }

  .event__body :global(a) {
    color: var(--lane-text);
    text-underline-offset: 0.2em;
  }

  /*
   * The pre-animation state is applied only when JavaScript is running AND
   * the visitor has not asked for reduced motion. With JS off, or motion
   * reduced, the card simply renders — content is never hidden behind an
   * animation that might not fire.
   */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .event[data-animate] {
      opacity: 0;
      transform: translateY(1.25rem);
      transition:
        opacity 0.5s ease-out,
        transform 0.5s ease-out;
    }

    :global(html.js) .event[data-animate].is-visible {
      opacity: 1;
      transform: none;
    }
  }
</style>
