---
import { getCollection } from 'astro:content';
import TimelineEvent from './TimelineEvent.astro';

/**
 * The signature layout: one shared year axis with career on the left and life
 * on the right. Same years, two stories.
 *
 * Drafts are excluded here, at the single point where entries are read, so an
 * unconfirmed entry cannot reach the page by any route.
 */
const published = await getCollection('timeline', ({ data }) => !data.draft);
const draftCount = (await getCollection('timeline')).length - published.length;

const entries = published.sort(
  (a, b) => a.data.year - b.data.year || a.data.order - b.data.order,
);

const years = [...new Set(entries.map((e) => e.data.year))].sort((a, b) => a - b);

const groups = years.map((year) => ({
  year,
  career: entries.filter((e) => e.data.year === year && e.data.lane === 'career'),
  life: entries.filter((e) => e.data.year === year && e.data.lane === 'life'),
}));

const hasLife = entries.some((e) => e.data.lane === 'life');
---

<section class="timeline-section" aria-labelledby="timeline-heading">
  <div class="wrap">
    <header class="timeline-header">
      <h2 id="timeline-heading">Two tracks</h2>
      <p class="measure">
        A career and a life run on the same clock. Here they are side by side.
      </p>

      <p class="legend">
        <span class="legend__item legend__item--career">Work</span>
        <span class="legend__item legend__item--life">Life</span>
      </p>
    </header>

    {
      groups.length === 0 ? (
        <p class="empty">
          No timeline entries yet. Add Markdown files to
          <code>src/content/timeline/</code> — see <code>CONTENT.md</code>.
        </p>
      ) : (
        <div class="timeline" data-timeline data-has-life={hasLife ? 'true' : 'false'}>
          <div class="readout" aria-hidden="true">
            <span data-year-readout>{years[0]}</span>
          </div>

          <ol class="timeline__list">
            {groups.map(({ year, career, life }) => (
              <li class="year" data-year={year}>
                <h3 class="year__marker">
                  <span class="year__label">{year}</span>
                </h3>

                <div class="lane lane--career">
                  {career.map((entry) => (
                    <TimelineEvent entry={entry} />
                  ))}
                </div>

                <div class="lane lane--life">
                  {life.map((entry) => (
                    <TimelineEvent entry={entry} />
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </div>
      )
    }

    {
      import.meta.env.DEV && draftCount > 0 && (
        <p class="draft-note">
          <strong>Dev note:</strong> {draftCount} draft{draftCount === 1 ? '' : 's'} hidden.
          These are entries inferred rather than confirmed. Set{' '}
          <code>draft: false</code> once she has verified them.
        </p>
      )
    }
  </div>
</section>

<style>
  .timeline-section {
    padding-block: var(--section-gap);
  }

  .timeline-header h2 {
    font-size: var(--step-4);
    margin: 0 0 0.5rem;
  }

  .timeline-header p {
    color: var(--ink-muted);
    margin: 0;
  }

  .legend {
    display: flex;
    gap: 1.25rem;
    margin-top: 1.25rem !important;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .legend__item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .legend__item::before {
    content: '';
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    background-color: currentColor;
  }

  .legend__item--career {
    color: var(--career-text);
  }

  .legend__item--life {
    color: var(--life-text);
  }

  .empty,
  .draft-note {
    margin-top: 2rem;
    padding: 1rem 1.25rem;
    border: 1px dashed var(--rule);
    border-radius: 0.5rem;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  /* ---- the axis ---------------------------------------------------- */

  .timeline {
    position: relative;
    margin-top: 3rem;
    /* Where the spine sits. Overridden at the desktop breakpoint. */
    --axis-x: 1.25rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    inset-block: 0;
    left: var(--axis-x);
    width: 2px;
    transform: translateX(-50%);
    /* Fades at both ends so the line does not collide with adjacent
       sections. */
    background: linear-gradient(
      to bottom,
      transparent,
      var(--rule) 3rem,
      var(--rule) calc(100% - 3rem),
      transparent
    );
  }

  .timeline__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2.5rem;
  }

  /* ---- year groups ------------------------------------------------- */

  .year {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    column-gap: 1rem;
    row-gap: 1rem;
    align-items: start;
  }

  .year__marker {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    justify-self: center;
    font-family: var(--font-sans);
    font-size: var(--step--1);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  .year__label {
    display: grid;
    place-items: center;
    background-color: var(--paper);
    color: var(--ink-muted);
    border: 2px solid var(--rule);
    border-radius: 999px;
    padding: 0.35rem 0.1rem;
    width: 3.25rem;
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  /* The year the reader is currently inside. */
  .year.is-active .year__label {
    color: var(--ink);
    border-color: var(--ink-muted);
  }

  .lane {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .lane:empty {
    display: none;
  }

  .lane--career,
  .lane--life {
    grid-column: 2;
  }

  /* ---- sticky year readout (mobile only) --------------------------- */

  .readout {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    justify-content: center;
    padding-block: 0.5rem;
    pointer-events: none;
  }

  .readout span {
    background-color: var(--paper-sunk);
    border: 1px solid var(--rule);
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    padding: 0.2rem 0.85rem;
    border-radius: 999px;
  }

  /* ---- desktop: two true lanes ------------------------------------- */

  @media (min-width: 48rem) {
    .timeline {
      --axis-x: 50%;
    }

    /* The in-flow year pills carry the axis on desktop, so the floating
       readout is redundant. */
    .readout {
      display: none;
    }

    .year {
      grid-template-columns: 1fr 3.25rem 1fr;
      column-gap: clamp(1rem, 0.4rem + 2vw, 2.5rem);
      align-items: center;
    }

    .year__marker {
      grid-column: 2;
      grid-row: 1;
    }

    .lane--career {
      grid-column: 1;
      grid-row: 1;
    }

    .lane--life {
      grid-column: 3;
      grid-row: 1;
    }

    /* Both lanes' accent edges point inward, at the spine. */
    .lane--career :global(.event) {
      border-inline-start: 1px solid var(--rule);
      border-inline-end: 4px solid var(--career);
    }

    /*
     * When a year has work but no life entry (or the reverse), the empty
     * lane is display:none — which would let the remaining card stretch
     * across the axis. Pinning the grid columns keeps every card in its
     * own lane regardless.
     */
    .lane:empty {
      display: block;
      visibility: hidden;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');

  if (timeline) {
    const readout = timeline.querySelector<HTMLElement>('[data-year-readout]');
    const years = Array.from(timeline.querySelectorAll<HTMLElement>('.year'));

    // Tracks which year groups are on screen; the topmost one wins.
    const visible = new Set<HTMLElement>();

    const yearObserver = new IntersectionObserver(
      (records) => {
        for (const record of records) {
          const el = record.target as HTMLElement;
          if (record.isIntersecting) visible.add(el);
          else visible.delete(el);
        }

        const topmost = years.find((y) => visible.has(y));
        if (!topmost) return;

        for (const y of years) y.classList.toggle('is-active', y === topmost);
        if (readout) readout.textContent = topmost.dataset.year ?? '';
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: 0 },
    );

    for (const year of years) yearObserver.observe(year);

    // Entry reveal. Skipped entirely when the visitor prefers reduced motion,
    // in which case the CSS never hides the cards in the first place.
    const wantsMotion = window.matchMedia('(prefers-reduced-motion: no-preference)');

    if (wantsMotion.matches) {
      const revealObserver = new IntersectionObserver(
        (records, observer) => {
          for (const record of records) {
            if (!record.isIntersecting) continue;
            record.target.classList.add('is-visible');
            observer.unobserve(record.target);
          }
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.1 },
      );

      for (const el of timeline.querySelectorAll('[data-animate]')) {
        revealObserver.observe(el);
      }
    }
  }
</script>
