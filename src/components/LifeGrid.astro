---
import { getCollection, render } from 'astro:content';

// Drafts filtered at the point of reading, same rule as the timeline.
const cards = (await getCollection('life', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const rendered = await Promise.all(
  cards.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

{
  rendered.length > 0 && (
    <section class="life" aria-labelledby="life-heading">
      <div class="wrap">
        <header class="life__header">
          <h2 id="life-heading">Off the clock</h2>
          <p class="measure">The other half of the story.</p>
        </header>

        <ul class="life__grid">
          {rendered.map(({ entry, Content }) => (
            <li class="card">
              {entry.data.icon && (
                <span class="card__icon" aria-hidden="true">
                  {entry.data.icon}
                </span>
              )}
              <h3 class="card__title">{entry.data.title}</h3>
              <div class="card__body">
                <Content />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )
}

<style>
  .life {
    padding-block: var(--section-gap);
    background-color: var(--paper-sunk);
    border-block: 1px solid var(--rule);
  }

  .life__header h2 {
    font-size: var(--step-4);
    margin: 0 0 0.5rem;
  }

  .life__header p {
    margin: 0;
    color: var(--ink-muted);
  }

  .life__grid {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
  }

  .card {
    background-color: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    padding: 1.5rem;
    border-top: 4px solid var(--life);
  }

  .card__icon {
    font-size: var(--step-3);
    line-height: 1;
    display: block;
    margin-bottom: 0.75rem;
  }

  .card__title {
    margin: 0 0 0.5rem;
    font-size: var(--step-1);
    font-weight: 600;
  }

  .card__body {
    color: var(--ink-muted);
    font-size: var(--step-0);
  }

  .card__body :global(p) {
    margin: 0 0 0.75rem;
  }

  .card__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
