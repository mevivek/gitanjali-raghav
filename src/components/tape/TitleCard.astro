---
import { Image } from 'astro:assets';
import { slugs, title } from '../../data/tape';

interface Props {
  /** Position on the strip. Screen 0 is the one the tape opens on. */
  index: number;
}

const { index } = Astro.props;
---

<section
  class="screen screen--title screen--flat"
  id={slugs[index]}
  data-screen
  data-active={index === 0 ? 'true' : 'false'}
  aria-label="Title card"
>
  {/* Gold on the left, the tape's own catalogue number on the right. */}
  <p class="kicker">
    <span>{title.kicker}</span>
    <span class="kicker__code">{title.kickerRight}</span>
  </p>

  <div class="cassette">
    <span class="cassette__screw cassette__screw--left" aria-hidden="true"></span>
    <span class="cassette__screw cassette__screw--right" aria-hidden="true"></span>

    <div class="cassette__window">
      {/*
        320×320 source — her Instagram profile picture, and the smallest
        image on the site. Shown at ~284px so it still holds, but it cannot
        go bigger. No `widths` here: there is nothing to pick between.
      */}
      <Image
        class="cassette__photo"
        src={title.photo}
        alt={title.alt}
        width={320}
        loading="eager"
        decoding="async"
      />
      <div class="cassette__scan" aria-hidden="true"></div>
      <div class="cassette__bleed" aria-hidden="true"></div>

      {/* The two spools, turning at different speeds behind the picture. */}
      <span class="spool spool--left" aria-hidden="true"></span>
      <span class="spool spool--right" aria-hidden="true"></span>

      <div class="rec" aria-hidden="true">
        <span class="rec__dot"></span>REC
      </div>

      <p class="cassette__scribble" aria-hidden="true">{title.scribble}</p>
    </div>

    {/* The paper label, stuck on slightly crooked and written on twice. */}
    <div class="cassette__label" aria-hidden="true">
      <span class="cassette__line">
        <span class="cassette__name">{title.labelName}</span>
        <span class="cassette__code">{title.labelCode}</span>
      </span>
      <span class="cassette__line cassette__line--was">
        <span class="cassette__was">{title.labelWas}</span>
        <span class="cassette__years">{title.labelYears}</span>
      </span>
    </div>
  </div>

  {/*
    Three lines, and the middle one is not the same kind of thing as the other
    two — it is her handwriting, gold and crooked, wedged between two lines of
    stencil. So it is a span with its own rules rather than a `<br />` apart.
  */}
  <h1 class="title">
    <span class="title__stencil">{title.headingTop}</span>
    <span class="title__hand">{title.headingHand}</span>
    <span class="title__stencil title__stencil--flip">{title.headingBottom}</span>
  </h1>

  <p class="intro">{title.intro}</p>

  {/*
    A cassette deck's keypad. Only the middle key does anything: the outer two
    are the deck's own furniture and are `aria-hidden`, because announcing two
    unusable buttons either side of the real one is worse than saying nothing.

    The middle one is an anchor, not a button: with no script this still moves
    the tape to reel 01, because the strip is a real scroll container. The
    script upgrades it to a smooth glide.
  */}
  <div class="deck" data-nodrag>
    <span class="deck__key" aria-hidden="true">&#9664;&#9664;</span>

    <a class="play" href={`#${slugs[1]}`} data-tape-go="1">
      <span class="play__glyph" aria-hidden="true">&#9654;</span>{title.playLabel}
    </a>

    <span class="deck__key" aria-hidden="true">&#9654;&#9654;</span>
  </div>

  {/* The gesture differs by layout, so both are written and CSS picks one. */}
  <p class="hint">
    <span class="hint--narrow">swipe up &#8593;</span>
    <span class="hint--wide">drag the tape &#8592; &#8594;</span>
  </p>
</section>

<style>
  .kicker {
    width: 100%;
    max-width: 520px;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--tape-gold);
  }

  .kicker__code {
    color: var(--tape-muted-dim);
  }

  /* ------------------------------------------------------------- cassette */

  .cassette {
    position: relative;
    width: var(--cassette-w);
    aspect-ratio: 5 / 3.5;
    padding: 9px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    border-radius: 9px;
    background: linear-gradient(160deg, #2b1c3a, #170e22 58%, #0d0813);
    box-shadow:
      0 26px 60px rgb(0 0 0 / 75%),
      inset 0 1px 0 rgb(255 255 255 / 12%),
      inset 0 0 0 1px var(--tape-edge);
  }

  /* The cassette rocks very slightly, as if resting on an uneven surface. */
  @media (prefers-reduced-motion: no-preference) {
    .cassette {
      animation: tape-wob 11s ease-in-out infinite;
    }
  }

  .cassette__screw {
    position: absolute;
    top: 4px;
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background-color: #0a0610;
    box-shadow: inset 0 1px 1px rgb(255 255 255 / 30%);
  }

  .cassette__screw--left {
    left: 4px;
  }

  .cassette__screw--right {
    right: 4px;
  }

  .cassette__window {
    position: relative;
    flex: 1 1 auto;
    /* Holds the picture's share of the shell once the label takes two lines. */
    min-height: 64%;
    border-radius: 3px;
    overflow: hidden;
    background-color: var(--tape-panel);
    box-shadow: inset 0 0 0 1px rgb(62 224 232 / 30%);
  }

  .cassette__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 6%;
    filter: saturate(1.5) contrast(1.1) brightness(0.9);
  }

  .cassette__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 40%) 0 1px, transparent 1px 3px);
    /* Scanlines belong to the full VHS grade only — see tape.css. */
    opacity: var(--scan-op, 0);
  }

  .cassette__bleed {
    position: absolute;
    inset: 0;
    mix-blend-mode: screen;
    background: linear-gradient(
      90deg,
      rgb(255 46 136 / 26%),
      transparent 34%,
      transparent 66%,
      rgb(62 224 232 / 26%)
    );
  }

  /*
   * The spools. Dashed rings rather than drawn hubs: a dashed border turning
   * slowly is exactly what a spool's teeth look like through a cassette window,
   * and it costs no image. The percentage margin resolves against the ring's own
   * containing block width, which is how half of 27% centres it vertically.
   */
  .spool {
    position: absolute;
    top: 50%;
    width: 27%;
    aspect-ratio: 1;
    margin-top: -13.5%;
    border-radius: 999px;
    box-shadow: inset 0 0 0 4px rgb(8 4 13 / 50%);
  }

  .spool--left {
    left: 8%;
    border: 5px dashed rgb(246 239 230 / 50%);
  }

  .spool--right {
    right: 8%;
    border: 5px dashed rgb(246 239 230 / 34%);
  }

  /* Different speeds, because a playing tape's two spools are never in step. */
  @media (prefers-reduced-motion: no-preference) {
    .spool--left {
      animation: tape-spool 9s linear infinite;
    }

    .spool--right {
      animation: tape-spool 14s linear infinite;
    }
  }

  .rec {
    position: absolute;
    left: 9px;
    top: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.12em;
    color: #fff;
    text-shadow: 0 1px 3px #000;
  }

  .rec__dot {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background-color: var(--tape-pink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rec__dot {
      animation: tape-rec 1.4s steps(1) infinite;
    }
  }

  .cassette__scribble {
    position: absolute;
    right: 9px;
    bottom: 6px;
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 20px;
    color: var(--tape-gold);
    transform: rotate(-4deg);
    text-shadow: 0 2px 6px #000;
  }

  /* ---------------------------------------------------------- the label */

  .cassette__label {
    flex: 0 0 auto;
    padding: 5px 10px 6px;
    display: flex;
    flex-direction: column;
    gap: 1px;
    border-radius: 3px;
    background: linear-gradient(var(--tape-label-bright), var(--tape-label-shade));
    transform: rotate(-0.5deg);
    box-shadow: 0 2px 8px rgb(0 0 0 / 50%);
  }

  .cassette__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    overflow: hidden;
  }

  .cassette__name {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.1;
    white-space: nowrap;
    color: var(--tape-label-ink);
  }

  .cassette__code {
    font-family: var(--font-osd);
    font-size: 11px;
    letter-spacing: 0.14em;
    white-space: nowrap;
    color: var(--tape-label-mute);
  }

  /* What the tape was called before she gave up naming the versions. */
  .cassette__line--was {
    font-family: var(--font-osd);
    font-size: 10px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #a08a6a;
  }

  .cassette__was {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    text-decoration: line-through;
  }

  .cassette__years {
    white-space: nowrap;
    color: var(--tape-label-mute);
  }

  /* ---------------------------------------------------------------- words */

  .title {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: var(--step-h1);
    font-weight: 400;
    line-height: 0.82;
    text-align: center;
  }

  .title__stencil {
    font-family: var(--font-display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--tape-cream);
    /* Mis-registered colour, like a tape tracking a shade off. */
    text-shadow:
      3px 0 0 var(--tape-pink),
      -3px 0 0 var(--tape-cyan);
  }

  /* The bottom line's fringe is the other way round, so the pair frames the
     handwriting between them rather than repeating. */
  .title__stencil--flip {
    text-shadow:
      3px 0 0 var(--tape-cyan),
      -3px 0 0 var(--tape-pink);
  }

  .title__hand {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 0.78em;
    line-height: 0.9;
    color: var(--tape-gold);
    transform: rotate(-2.5deg);
    /* Pulls the crooked line in tight against the two stencilled ones. */
    margin: -0.04em 0 -0.06em;
  }

  .intro {
    max-width: 34ch;
    text-align: center;
    font-family: var(--font-osd);
    font-size: var(--step-body);
    line-height: 1.4;
    letter-spacing: 0.04em;
    color: var(--tape-body-dim);
  }

  /* --------------------------------------------------------- the keypad */

  .deck {
    width: 100%;
    max-width: 380px;
    display: grid;
    /* The play key is the wide one, as it is on a deck. */
    grid-template-columns: 1fr 1.7fr 1fr;
    gap: 7px;
    padding: 8px;
    border-radius: 5px;
    background: linear-gradient(#1d1327, #120c1a);
    box-shadow:
      inset 0 0 0 1px #3b2a4d,
      0 14px 30px rgb(0 0 0 / 60%);
  }

  .deck__key {
    display: grid;
    place-items: center;
    height: 50px;
    border-radius: 3px;
    background-color: var(--tape-shell-deep);
    box-shadow:
      inset 0 0 0 1px #2e2140,
      0 3px 0 #0c0812;
    font-family: var(--font-osd);
    font-size: var(--osd-lg);
    letter-spacing: 0.1em;
    color: #4d3d5e;
  }

  .play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: 50px;
    border: 0;
    border-radius: 3px;
    background-color: var(--tape-pink);
    color: var(--tape-black);
    font-family: var(--font-display);
    font-size: 18px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 4px 0 #a4165a;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .play:hover {
    background-color: var(--tape-gold);
    color: var(--tape-black);
    box-shadow: 0 4px 0 #a67918;
  }

  /* Travels like a key, rather than sliding like a card. */
  .play:active {
    transform: translateY(3px);
    box-shadow: 0 1px 0 #a4165a;
  }

  .play__glyph {
    font-size: 13px;
  }

  .hint {
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.16em;
    color: var(--tape-muted-dim);
  }

  .hint--wide {
    display: none;
  }

  @media (min-width: 900px) {
    .hint--narrow {
      display: none;
    }

    .hint--wide {
      display: inline;
    }
  }

  /*
   * A phone held sideways: the shell is too shallow for two lines of label, and
   * the picture matters more than knowing what the tape used to be called.
   */
  @media (max-height: 700px) {
    .cassette__window {
      min-height: 0;
    }

    .cassette__name {
      font-size: 16px;
    }

    .cassette__line--was {
      display: none;
    }
  }
</style>
