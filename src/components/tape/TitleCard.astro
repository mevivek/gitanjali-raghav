---
import { Image } from 'astro:assets';
import { slugs, title } from '../../data/tape';

interface Props {
  /** Position on the strip. Screen 0 is the one the tape opens on. */
  index: number;
}

const { index } = Astro.props;
---

<section
  class="screen screen--title screen--flat"
  id={slugs[index]}
  data-screen
  data-active={index === 0 ? 'true' : 'false'}
  style={`--photo-pos: ${title.pos}`}
  aria-label="Title card"
>
  {/*
    The card is a poster for the tape, printed on a photograph of her.

    It used to be a drawn cassette on a purple gradient — shell, screws, two
    turning spools, a REC dot, and a paper label with the tape's old name struck
    out. That is in the git history. The third handoff replaced it with this, and
    the trade is worth knowing: the cassette explained what the site was by
    illustrating the object, and the poster does it by behaving like one. A
    photograph of her at the top of the page also does more than a drawing of a
    cassette with a 320px thumbnail in the window, which is what that was.

    Note there is deliberately still nothing above the photograph. The bundle put
    a "home video · e-180 · side a" strip back along the top; it was removed on
    purpose in 5cb2778 and stays removed. The billing block below carries the
    running time and the certificate, which is what that strip was really for.
  */}
  <Image
    class="poster__photo"
    src={title.photo}
    alt={title.alt}
    width={1080}
    widths={[400, 720, 1080]}
    sizes="(min-width: 900px) min(44vw, 560px), 100vw"
    loading="eager"
    fetchpriority="high"
    decoding="async"
  />

  {/*
    Three sheets over the photograph, in order: a vertical scrim that keeps the
    type legible at the bottom and darkens the very top, the tape's
    mis-registered colour bleed, and the scanlines. All decoration, all
    pointer-transparent — the play key underneath has to stay pressable.
  */}
  <div class="poster__scrim" aria-hidden="true"></div>
  <div class="poster__bleed" aria-hidden="true"></div>
  <div class="poster__scan" aria-hidden="true"></div>

  <div class="poster__plate">
    {/*
      Everything below is a fraction of `--step-poster`, so the poster scales as
      one thing rather than as six independently clamped sizes.
    */}
    <p class="poster__name">{title.name}</p>

    {/*
      Three lines, and the middle one is not the same kind of thing as the other
      two — it is her handwriting, gold and crooked, wedged between two lines of
      stencil. So it is a span with its own rules rather than a `<br />` apart.
      Left-aligned here, where the cassette card centred them.
    */}
    <h1 class="poster__title">
      <span class="poster__stencil">{title.headingTop}</span>
      <span class="poster__hand">{title.headingHand}</span>
      <span class="poster__stencil poster__stencil--flip">{title.headingBottom}</span>
    </h1>

    {/* The billing block, under a gold hairline, as a poster prints it. */}
    <div class="bill">
      <p class="bill__reels">{title.billReels}</p>
      <p class="bill__footer">{title.billFooter}</p>
    </div>

    {/*
      One key, full width, and an anchor rather than a button: with no script
      this still moves the tape to reel 01, because the strip is a real scroll
      container. The script upgrades it to a smooth glide.

      The cassette card had this flanked by two dead rewind/forward keys, as a
      deck's keypad. A poster is not a deck, so they went with the cassette —
      which is a small mercy, because they were `aria-hidden` furniture that
      existed only to make the middle key look like part of a machine.
    */}
    <a class="play" href={`#${slugs[1]}`} data-tape-go="1" data-nodrag>
      <span class="play__glyph" aria-hidden="true">&#9654;</span>{title.playLabel}
    </a>

    {/* The gesture differs by layout, so both are written and CSS picks one. */}
    <p class="hint">
      <span class="hint--narrow">swipe up &#8593;</span>
      <span class="hint--wide">drag the tape &#8592; &#8594;</span>
    </p>
  </div>
</section>

<style>
  /*
    The title card is the one screen that is a single photograph with type on it
    and no frame, so it overrides the flex column `.screen` sets up: the photo and
    the scrims are absolutely positioned and the plate is the only thing in flow.
  */
  .screen--title {
    position: relative;
    overflow: hidden;
    /* The plate is bottom-anchored, as a poster's billing always is. */
    justify-content: flex-end;
    align-items: stretch;
    padding: 0;
  }

  .poster__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--photo-pos, 50% 20%);
    filter: saturate(1.45) contrast(1.14) brightness(0.84);
  }

  .poster__scrim,
  .poster__bleed,
  .poster__scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /*
   * Dark at the very top so the notch has something behind it, clear through her
   * face, then heavy from just above the plate down. The stops are what let a
   * white-on-photograph headline clear AA without a flat black bar under it.
   */
  .poster__scrim {
    background: linear-gradient(
      to bottom,
      rgb(8 4 13 / 72%) 0%,
      rgb(8 4 13 / 10%) 14%,
      rgb(8 4 13 / 6%) 26%,
      rgb(8 4 13 / 74%) 58%,
      rgb(8 4 13 / 98%) 82%
    );
  }

  .poster__bleed {
    background: linear-gradient(
      96deg,
      rgb(255 46 136 / 14%),
      transparent 40%,
      transparent 62%,
      rgb(62 224 232 / 12%)
    );
  }

  .poster__scan {
    background: var(--scanline);
    /* Scanlines belong to the full VHS grade only — see tape.css. */
    opacity: var(--scan-op, 0);
  }

  /* ---------------------------------------------------------------- plate */

  .poster__plate {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--poster-gap);
    padding: var(--pad-title);
    /* Every size on the card is a fraction of this one number. */
    --poster-gap: max(9px, calc(var(--step-poster) * 0.21));
    /*
     * The safety net. `--step-poster` takes 17% of the height, which keeps the
     * plate inside the screen at every size that has been looked at — but the
     * bottom padding also has to clear the transport, and a 380px-tall landscape
     * phone is tight enough that the two fight. If it ever loses, the plate
     * scrolls rather than the name clipping off the top of the poster.
     */
    max-height: 100%;
    overflow-y: auto;
  }

  .poster__plate > * {
    /* Nothing on the plate is centred; the billing rule needs the full width. */
    align-self: stretch;
  }

  .poster__name {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: calc(var(--step-poster) * 0.44);
    line-height: 1;
    color: var(--tape-gold);
    transform: rotate(-1.6deg);
    transform-origin: left center;
    text-shadow: 0 2px 10px rgb(0 0 0 / 70%);
  }

  .poster__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    font-size: var(--step-poster);
    font-weight: 400;
    line-height: 0.8;
  }

  .poster__stencil {
    font-family: var(--font-display);
    letter-spacing: -0.025em;
    text-transform: uppercase;
    color: var(--tape-cream);
    /* Mis-registered colour, like a tape tracking a shade off. */
    text-shadow:
      3px 0 0 var(--tape-pink),
      -3px 0 0 var(--tape-cyan);
  }

  /* The bottom line's fringe is the other way round, so the pair frames the
     handwriting between them rather than repeating. */
  .poster__stencil--flip {
    text-shadow:
      3px 0 0 var(--tape-cyan),
      -3px 0 0 var(--tape-pink);
  }

  .poster__hand {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 0.62em;
    line-height: 0.92;
    color: var(--tape-gold);
    transform: rotate(-2.2deg);
    transform-origin: left center;
    /* Pulls the crooked line in tight against the two stencilled ones. */
    margin: -0.02em 0 -0.04em 0.06em;
  }

  /* ----------------------------------------------------------- the billing */

  .bill {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 9px;
    border-top: 1px solid rgb(255 197 61 / 40%);
  }

  .bill__reels,
  .bill__footer {
    font-family: var(--font-osd);
    font-size: clamp(11px, calc(var(--step-poster) * 0.22), 14px);
    line-height: 1.32;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .bill__reels {
    color: #f0d3b8;
  }

  .bill__footer {
    color: #a5919b;
  }

  /* -------------------------------------------------------------- the key */

  .play {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    border: 0;
    border-radius: 3px;
    background-color: var(--tape-gold);
    color: #1e0a06;
    font-family: var(--font-display);
    font-size: 19px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: 0 5px 0 #a67918;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .play:hover {
    background-color: var(--tape-cream);
    color: #1e0a06;
    box-shadow: 0 5px 0 #8c7f6d;
  }

  /* Travels like a key, rather than sliding like a card. */
  .play:active {
    transform: translateY(3px);
    box-shadow: 0 2px 0 #a67918;
  }

  .play__glyph {
    font-size: 13px;
  }

  .hint {
    text-align: center;
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tape-muted);
  }

  .hint--wide {
    display: none;
  }

  @media (min-width: 900px) {
    .hint--narrow {
      display: none;
    }

    .hint--wide {
      display: inline;
    }
  }

  /* A phone held sideways: the plate has to give up its air before its type. */
  @media (max-height: 700px) {
    .poster__plate {
      --poster-gap: max(6px, calc(var(--step-poster) * 0.14));
    }

    .bill {
      padding-top: 6px;
    }

    .play {
      min-height: 46px;
      font-size: 17px;
    }

    /*
     * And the hint goes. In landscape the plate is within a few pixels of the
     * screen height, so this line ends up sitting under the transport keys — and
     * of everything on the poster it is the most expendable, because the key
     * directly above it already says what to do. The interval drops its own
     * b-side hint at this width for the same reason.
     */
    .hint {
      display: none;
    }
  }
</style>
