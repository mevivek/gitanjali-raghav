---
import { Image } from 'astro:assets';
import { reelCount, salt, slugs, stepFor } from '../../../data/tape';

interface Props {
  index: number;
}

const { index } = Astro.props;

/* Server-rendered at zero splashes, which is also the no-script state. */
const start = 0;

const vars = [
  `--accent: ${salt.accent}`,
  `--reel-bg: ${salt.bg}`,
  `--photo-pos: ${salt.pos}`,
].join('; ');
---

<section
  class="screen screen--reel screen--bleed"
  id={slugs[index]}
  data-screen
  data-active="false"
  data-salt
  data-copy={JSON.stringify({
    cap: salt.cap,
    prompts: salt.prompts,
    hands: salt.hands,
    lines: salt.lines,
  })}
  style={vars}
  aria-label={`Reel ${salt.num} of ${reelCount} — ${salt.label}`}
>
  {/*
    Full bleed since the third handoff: the photograph is the screen rather than
    a picture in a frame on it. The skeleton is in src/styles/tape.css — see the
    note there on why reels 01–03 bleed and 04–06 do not.
  */}
  <Image
    class="bleed__photo photo"
    src={salt.photo}
    alt={salt.alt}
    width={1080}
    widths={[400, 720, 1080]}
    sizes="(min-width: 900px) min(44vw, 560px), 100vw"
    loading="eager"
    decoding="async"
  />

  {/*
    A real button rather than a listener on the photograph, so it can be
    reached and pressed from a keyboard. It has no visible border of its own
    — the photograph is the surface — but it does take a focus ring, which is
    the only way a keyboard user would know it is here at all.

    It covers the whole screen now. In the framed layout it had to stop 84px
    short of the bottom to keep the caption selectable; the caption has moved out
    of the photograph and onto the plate above this, which turns pointer events
    back on only for itself, so the water can have the rest.

    Hidden without script: an invisible button that does nothing is worse
    than no button. The reel still reads without it.
  */}
  <button class="water" type="button" data-nodrag data-salt-tap>
    <span class="sr-only">{salt.action}</span>
  </button>

  {/* Ripples are appended here, then removed when their animation ends. */}
  <div class="ripples" data-salt-ripples aria-hidden="true"></div>

  <div class="bleed__scrim" aria-hidden="true"></div>
  <div class="bleed__scan" aria-hidden="true"></div>

  <div class="bleed__plate">
    <p class="bleed__top">
      <span class="bleed__reel">reel {salt.num} / {String(reelCount).padStart(2, '0')}</span>
      <span class="bleed__stamp">{salt.readout}</span>
    </p>

    <span class="bleed__gap"></span>

    <div class="bleed__words">
      <div class="bleed__caption">
        <h2 class="reel__title">{salt.title}</h2>
        <p class="reel__hand" data-salt-hand>{stepFor(salt.hands, start)}</p>
      </div>

      {/*
        The prompt and the splash count. Part of the interaction rather than the
        on-screen display, so `look.osd` does not hide them — without them there
        is no sign the tape noticed you.

        aria-live so the count is announced as it changes; a screen reader user
        pressing the button gets the same feedback a sighted one does.
      */}
      <p class="gauge reel__controls" data-nodrag>
        <span data-salt-prompt>{stepFor(salt.prompts, start)}</span>
        <span class="gauge__count" aria-live="polite" data-salt-count
          >splash {String(start).padStart(2, '0')}</span
        >
      </p>

      <p class="reel__line" data-salt-line>{stepFor(salt.lines, start)}</p>
    </div>
  </div>
</section>

<style>
  .screen--reel {
    background: var(--reel-bg);
  }

  /* Grade drifts warmer and more saturated the deeper in she gets. */
  .photo {
    filter: saturate(calc(1.2 + var(--wet, 0) * 0.35)) contrast(1.08)
      brightness(calc(0.88 + var(--wet, 0) * 0.14)) hue-rotate(-6deg);
    transition: filter 0.3s linear;
  }

  .water {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: none;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    /* A press on a photograph should not offer to copy it or select round it. */
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  :global(html.js) .water {
    display: block;
  }

  .water:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: -6px;
    border-radius: 2px;
  }

  .ripples {
    position: absolute;
    inset: 0;
    z-index: 3;
    pointer-events: none;
  }

  /*
   * Each ripple is positioned by the script from where the press landed. The
   * animation is the whole point of the element, so under reduced motion the
   * script does not create them at all — the counter and the copy still
   * respond, which is the part that carries meaning.
   */
  .ripples :global(span) {
    position: absolute;
    width: 26px;
    height: 26px;
    margin: -13px 0 0 -13px;
    border: 2px solid rgb(255 255 255 / 90%);
    border-radius: 999px;
    box-shadow: 0 0 14px rgb(62 224 232 / 90%);
    animation: tape-ripple 0.9s ease-out forwards;
  }

  .gauge {
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    height: 34px;
    font-family: var(--font-osd);
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--tape-cyan);
  }

  .gauge__count {
    color: #9fbcc4;
  }
</style>

<script>
  /*
   * The copy tables arrive on a data attribute rather than by importing
   * src/data/tape.ts. Importing it would pull that module into the client
   * bundle's graph, and because it imports the photographs, the build then emits
   * every original as an asset — megabytes of files nothing references. Vite
   * tree-shakes the bindings out of the JS, but the asset emission happens
   * anyway. So no client script here reaches into the data module.
   */
  type Step = { min: number; text: string };

  const stepFor = (steps: Step[], value: number): string => {
    for (const step of steps) if (value >= step.min) return step.text;
    return steps[steps.length - 1]?.text ?? '';
  };

  const screen = document.querySelector<HTMLElement>('[data-salt]');
  const tap = document.querySelector<HTMLButtonElement>('[data-salt-tap]');

  if (screen && tap) {
    const copy = JSON.parse(screen.dataset.copy ?? '{}') as {
      cap: number;
      prompts: Step[];
      hands: Step[];
      lines: Step[];
    };
    const pond = screen.querySelector<HTMLElement>('[data-salt-ripples]')!;
    const hand = screen.querySelector<HTMLElement>('[data-salt-hand]')!;
    const line = screen.querySelector<HTMLElement>('[data-salt-line]')!;
    const prompt = screen.querySelector<HTMLElement>('[data-salt-prompt]')!;
    const count = screen.querySelector<HTMLElement>('[data-salt-count]')!;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    let splashes = 0;

    /**
     * Where the press landed, as a percentage of the button. A keyboard press
     * reports no coordinates, so those ripple from the middle.
     */
    function ripple(event: PointerEvent | MouseEvent) {
      if (reduce.matches) return;

      const box = tap!.getBoundingClientRect();
      const hasPoint = event.clientX !== 0 || event.clientY !== 0;
      const x = hasPoint ? ((event.clientX - box.left) / box.width) * 100 : 50;
      const y = hasPoint ? ((event.clientY - box.top) / box.height) * 100 : 50;

      const ring = document.createElement('span');
      ring.style.left = `${x.toFixed(1)}%`;
      ring.style.top = `${y.toFixed(1)}%`;
      // Removing on animationend rather than a timer keeps the two in step if
      // the duration is ever changed in CSS.
      ring.addEventListener('animationend', () => ring.remove());
      pond.appendChild(ring);
    }

    tap.addEventListener('click', (event) => {
      document.dispatchEvent(new CustomEvent('tape:blip', { detail: 'click' }));
      splashes += 1;
      ripple(event);

      // Past the cap nothing further changes, so the copy stops churning.
      const n = Math.min(splashes, copy.cap);
      screen.style.setProperty('--wet', String(n / copy.cap));

      hand.textContent = stepFor(copy.hands, n);
      line.textContent = stepFor(copy.lines, n);
      prompt.textContent = stepFor(copy.prompts, n);
      count.textContent = `splash ${String(splashes).padStart(2, '0')}`;
    });
  }
</script>
