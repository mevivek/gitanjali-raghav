---
import { credits, ending, footage, slugs } from '../../data/tape';
import { site } from '../../data/site';

interface Props {
  /** Position on the strip. */
  index: number;
}

const { index } = Astro.props;

/*
 * The video source rides on a data attribute rather than being written into the
 * `src` here, for two reasons. It must not load until the credits are the screen
 * in front — a 15MB fetch for somebody who never reaches the end of the tape would
 * be indefensible — and the path has to be resolved against the site's base, which
 * a hand-written relative src would get wrong on a project page.
 */
const video = `${import.meta.env.BASE_URL}/${footage.src}`.replace(/\/+/g, '/');
---

<section
  class="screen screen--credits screen--flat"
  id={slugs[index]}
  data-screen
  data-active="false"
  data-credits
  data-roll-delay={ending.rollDelay}
  data-footage={video}
  aria-label="End credits"
>
  {/*
    The one moving picture on the tape, under the roll and graded nearly to black
    so the names stay readable over it. `aria-hidden` and muted: nothing in it
    carries meaning, and it has no audio track to unmute.

    No `src` attribute — the script sets it on arrival. See the note on `footage`
    in src/data/tape.ts for the three things that stop it loading at all.
  */}
  <video
    class="footage"
    muted
    loop
    playsinline
    preload="none"
    aria-hidden="true"
    tabindex="-1"
    data-credits-footage></video>

  <div class="footage__scrim" aria-hidden="true"></div>

  <div class="stage">
    <div class="roll" data-credits-roll>
      <p class="kicker">{ending.kicker}</p>

      <h2 class="heading">{ending.headingTop}<br />{ending.headingBottom}</h2>

      <dl class="credits">
        {
          credits.map((credit) => (
            <div class="credit">
              <dt class="credit__role">{credit.role}</dt>
              <dd class="credit__who">{credit.who}</dd>
            </div>
          ))
        }
      </dl>

      <p class="signoff">{ending.signoff}</p>

      <p class="the-end">{ending.theEnd}</p>
    </div>
  </div>

  <div class="actions">
    {/*
      The last two lines of the roll, set as a film's slug lines rather than as
      two buttons side by side — which is what they were until the fourth handoff.
      As rows they belong to the credits above them instead of sitting underneath
      as furniture, and they have room to say which of the two is which.

      Still real links to real places, so `rel="me"` and an explicit accessible
      name: the visible handle is not the platform, and "@gitanjaliraghav" alone
      does not say where it goes.
    */}
    <div class="slugs">
      {
        site.socials.map((social) => (
          <a
            class="slug"
            href={social.href}
            target="_blank"
            rel="me noopener noreferrer"
            aria-label={`${social.label} — ${social.who}`}
          >
            <span class="slug__role">{social.role}</span>
            <span class="slug__what">
              <span class="slug__who">{social.who}</span>
              <span class="slug__note">{social.note}</span>
            </span>
            <span class="slug__arrow" aria-hidden="true">&#8599;</span>
          </a>
        ))
      }
    </div>

    {/*
      A sticker off a rental tape, stuck on crooked. Two lines rather than one
      because the second is the whole joke, and `data-tape-blip` swaps the
      transport's clunk for the sound of the tape spooling back.
    */}
    <a class="rewind" href={`#${slugs[0]}`} data-tape-go="0" data-tape-blip="rewind">
      <span class="rewind__label">
        <span aria-hidden="true">&#9664;&#9664;</span> {ending.rewindLabel}
      </span>
      <span class="rewind__note">{ending.rewindNote}</span>
    </a>
  </div>
</section>

<style>
  /* ------------------------------------------------------------- the footage */

  /*
   * Behind everything on the screen, and only visible at all once the script has
   * given it a source — an empty `<video>` paints nothing, so there is no black
   * rectangle waiting over the gradient in the meantime.
   *
   * Graded hard: desaturated, dropped to 42% brightness, and then a near-opaque
   * scrim on top of that. The credits are white type on a moving background, and
   * the roll has to stay readable at every frame of the footage rather than at
   * most of them.
   */
  .footage {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: saturate(0.5) contrast(1.06) brightness(0.42);
    pointer-events: none;
  }

  .footage__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(rgb(8 4 13 / 72%), rgb(8 4 13 / 86%));
  }

  /*
   * Both are inert without a source, but the scrim would still darken the
   * screen's own gradient — so it only comes in once the video is actually
   * playing, which is what the attribute the script sets means.
   */
  .footage__scrim {
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  [data-footage-playing='true'] .footage__scrim {
    opacity: 1;
  }

  /* Everything else on the screen sits above the footage. */
  .stage,
  .actions {
    position: relative;
    z-index: 1;
  }

  /* --------------------------------------------------------------- the roll */

  .stage {
    position: relative;
    flex: 1 1 auto;
    /*
     * A floor, so the roll always has somewhere to run. Without it the slug lines
     * and the sticker below can squeeze the stage to nothing on a short window and
     * the credits vanish rather than scroll.
     */
    min-height: 300px;
    overflow: hidden;
  }

  .roll {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
    /*
     * The same place the animation's first frame puts it, so the held moment
     * before the roll starts and the roll's own beginning are identical — and
     * so removing the animation to replay it lands back here rather than
     * jumping.
     */
    transform: translateY(6%);
  }

  /*
   * This animation is the exception to the tape's "motion is decoration" rule:
   * it is what moves the credits past you, so the global reduced-motion
   * kill-switch must not simply freeze it — a frozen `creep` would leave the
   * names parked off the top of the screen where nobody can read them.
   *
   * So the roll only ever animates under `no-preference`. Under `reduce` it
   * falls back to a plain static list in a scrollable box, which reads
   * better anyway.
   */
  @keyframes creep {
    from {
      transform: translateY(6%);
    }

    to {
      transform: translateY(-104%);
    }
  }

  /*
   * Only rolls once the script says so — when this screen is the one in front,
   * and after it has been held still for a beat. See the note on
   * `ending.rollDelay` in src/data/tape.ts.
   */
  @media (prefers-reduced-motion: no-preference) {
    .roll[data-rolling='true'] {
      animation: creep 34s linear infinite;
    }

    /*
     * WCAG 2.2.2: moving content that runs for more than five seconds needs a
     * way to stop it. Hovering or tabbing into the credits does that, which
     * also happens to be what you instinctively do when you want to read a
     * name going past.
     */
    .stage:hover .roll,
    .stage:focus-within .roll {
      animation-play-state: paused;
    }
  }

  /*
   * Two cases where the roll never runs, and both need the same fallback: a
   * plain static list in a box you can scroll.
   *
   * Under reduced motion it must not animate at all. With no script, nothing
   * will ever set `data-rolling`, so it would sit frozen on its first frame
   * with every name below the fold clipped away and no way to reach them —
   * which would be worse than the animation this replaced.
   */
  @media (prefers-reduced-motion: reduce) {
    .stage {
      overflow-y: auto;
    }

    .roll {
      position: static;
      transform: none;
    }
  }

  :global(html:not(.js)) .stage {
    overflow-y: auto;
  }

  :global(html:not(.js)) .roll {
    position: static;
    transform: none;
  }

  /* ----------------------------------------------------------------- words */

  .kicker {
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--tape-muted-dim);
  }

  .heading {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 400;
    line-height: 0.86;
    text-transform: uppercase;
    color: var(--tape-cream);
    text-shadow:
      2px 0 0 var(--tape-pink),
      -2px 0 0 var(--tape-cyan);
  }

  /*
   * Two columns, as a credit roll is set: the job on the right of its own
   * column, the name on the left of the next, so the pairs meet down a single
   * gutter however long either side runs. `display: contents` on the wrapper
   * lets the <dt>/<dd> pairs be the grid's own items and keep their semantics.
   */
  .credits {
    margin: 0;
    width: 100%;
    max-width: 460px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px 16px;
    align-items: baseline;
  }

  .credit {
    display: contents;
  }

  .credit__role {
    text-align: right;
    font-family: var(--font-osd);
    font-size: var(--osd-sm);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    line-height: 1.3;
    color: var(--tape-muted);
  }

  .credit__who {
    margin: 0;
    text-align: left;
    font-family: var(--font-serif);
    font-size: 19px;
    line-height: 1.15;
    color: var(--tape-gold);
  }

  .signoff {
    max-width: 26ch;
    margin-top: 4px;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 23px;
    line-height: 1.25;
    color: var(--tape-cream);
  }

  .the-end {
    font-family: var(--font-display);
    font-size: 30px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tape-pink);
  }

  /* --------------------------------------------------------------- actions */

  .actions {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--slug-gap);
    padding-top: var(--slug-gap);
    --slug-gap: 10px;
  }

  /* Ruled top and bottom, as a block of slug lines is set. */
  .slugs {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgb(111 91 128 / 50%);
    border-bottom: 1px solid rgb(111 91 128 / 50%);
  }

  .slug {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 46px;
    padding: 11px 2px;
    transition: background-color 0.2s ease;
  }

  .slug + .slug {
    border-top: 1px dotted rgb(111 91 128 / 40%);
  }

  .slug:first-child:hover {
    background-color: rgb(255 46 136 / 9%);
  }

  .slug:last-child:hover {
    background-color: rgb(62 224 232 / 8%);
  }

  /* Right-aligned against the gutter, the way a credit's role is set. */
  .slug__role {
    flex: 0 0 auto;
    width: 106px;
    text-align: right;
    font-family: var(--font-osd);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--tape-muted-dim);
  }

  .slug__what {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .slug__who {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--tape-body);
  }

  /* Instagram is the one that gets the colour, as it did as a filled button. */
  .slug:first-child .slug__who {
    color: var(--tape-pink);
  }

  .slug__note {
    font-family: var(--font-osd);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tape-muted);
  }

  .slug__arrow {
    flex: 0 0 auto;
    font-family: var(--font-osd);
    font-size: 15px;
    color: var(--tape-muted-dim);
  }

  .slug:hover .slug__arrow {
    color: var(--tape-cream);
  }

  .rewind {
    min-height: 46px;
    padding: var(--sticker-pad, 9px 8px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    border: 3px solid #c2452c;
    border-radius: 3px;
    background: linear-gradient(var(--tape-label-bright), var(--tape-label-deep));
    color: #c2452c;
    font-family: var(--font-osd);
    text-transform: uppercase;
    cursor: pointer;
    transform: rotate(-1.4deg);
    box-shadow: 0 6px 18px rgb(0 0 0 / 50%);
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .rewind:hover {
    background: #c2452c;
    border-color: var(--tape-label-bright);
    color: var(--tape-label-bright);
  }

  .rewind:active {
    transform: rotate(-1.4deg) translateY(2px);
  }

  .rewind__label {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-size: 19px;
    letter-spacing: 0.26em;
  }

  .rewind__note {
    font-size: 11px;
    letter-spacing: 0.2em;
    opacity: 0.7;
  }

  /*
   * A short window: the roll needs a floor or it collapses to nothing behind the
   * slug lines, and the slug lines give up their sub-line and some air.
   */
  @media (max-height: 700px) {
    /*
     * Enough for the roll to move in, and no more: the slug lines and the sticker
     * below need the rest, and if this is left generous the sticker ends up under
     * the transport keys.
     */
    .stage {
      min-height: 130px;
    }

    .actions {
      --slug-gap: 6px;
      --sticker-pad: 6px 8px;
    }

    .slug {
      padding: 5px 2px;
    }

    .slug__role {
      width: 100px;
    }

    .slug__note {
      display: none;
    }
  }
</style>

<script>
  const credits = document.querySelector<HTMLElement>('[data-credits]');

  if (credits) {
    const roll = credits.querySelector<HTMLElement>('[data-credits-roll]')!;
    const delay = Number(credits.dataset.rollDelay ?? 2500);

    let waiting: number | null = null;

    /* ------------------------------------------------------------- footage */

    /*
     * The video behind the roll. Three things have to be true before 15MB is
     * fetched, and the first two are decided once, here.
     */
    const video = credits.querySelector<HTMLVideoElement>('[data-credits-footage]');
    const source = credits.dataset.footage;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    /*
     * The same test TapePrefetch makes before warming the photographs: not on a
     * metered connection, and not on 2g. That rule exists for ~3.5MB of images the
     * visitor will probably look at; it applies with far more force to 15MB of
     * decoration behind the last screen. Where the browser will not say, this goes
     * ahead — absence of the API is not evidence of a slow line.
     */
    type NetworkInfo = { saveData?: boolean; effectiveType?: string };
    const link = (navigator as Navigator & { connection?: NetworkInfo }).connection;
    const thrifty = Boolean(
      link?.saveData || (link?.effectiveType && /(^|-)2g$/.test(link.effectiveType)),
    );

    const wanted = Boolean(video && source) && !reduce.matches && !thrifty;

    /**
     * Attaches the source the first time the credits are reached, and plays.
     *
     * `play()` can still be rejected — a browser that will not autoplay even a
     * muted video, or one that cannot decode this file — and that is survivable:
     * the screen keeps its own gradient and the roll is unaffected, so the promise
     * is caught and dropped rather than reported.
     */
    function rollFootage() {
      if (!wanted || !video) return;
      if (!video.src) {
        video.src = source!;
        video.load();
      }
      void video.play().then(
        () => {
          credits!.dataset.footagePlaying = 'true';
        },
        () => {
          /* no autoplay, or no decoder for this file — the screen stands alone */
        },
      );
    }

    /* Off-screen video is exactly what this repo's timers rule is about. */
    function holdFootage() {
      if (!video || !video.src) return;
      video.pause();
    }

    function stop() {
      if (waiting !== null) {
        clearTimeout(waiting);
        waiting = null;
      }
      /*
       * Dropping the attribute drops the animation, which returns the roll to
       * the transform in its base rule — the same frame the animation starts
       * from. So the next arrival replays from the top instead of resuming
       * wherever it had got to.
       */
      delete roll.dataset.rolling;
      holdFootage();
    }

    function start() {
      /*
       * The footage starts immediately while the roll still waits out its hold —
       * arriving on a static frame and having it start moving a beat later is the
       * point of that delay, and the picture behind it coming up at the same moment
       * would make the whole screen lurch at once.
       */
      rollFootage();

      if (waiting !== null || roll.dataset.rolling === 'true') return;
      waiting = window.setTimeout(() => {
        waiting = null;
        roll.dataset.rolling = 'true';
      }, delay);
    }

    /*
     * `data-active` is maintained by the observer in index.astro, which already
     * works out which screen is in front. Watching the attribute keeps that
     * knowledge in one place rather than having this component decide again.
     */
    const watch = new MutationObserver(() => {
      if (credits.dataset.active === 'true') start();
      else stop();
    });

    watch.observe(credits, { attributes: true, attributeFilter: ['data-active'] });

    // Covers landing straight here via an #end link, where the attribute may
    // already be set before this script runs.
    if (credits.dataset.active === 'true') start();
  }
</script>
