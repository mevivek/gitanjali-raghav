---
import { Image } from 'astro:assets';
import { grades, look, reels, type Reel } from '../../data/tape';

interface Props {
  reel: Reel;
  /** Position on the strip. Reels are screens 1 through 6. */
  index: number;
}

const { reel, index } = Astro.props;

/*
 * 'tape' is the only grade that keeps each reel's own treatment — the cold
 * hue-rotate on the hills, the sepia on the motorcycle. The other two trade
 * that for one uniform look across all six, which is what makes them read as
 * a set rather than six different afternoons.
 */
const photoFilter = look.grade === 'tape' ? reel.filter : grades[look.grade];

/* Decorative when the display is off, so it should not be announced either. */
const osdHidden = look.osd ? undefined : true;

const vars = [
  `--accent: ${reel.accent}`,
  `--edge: ${reel.edge}`,
  `--reel-bg: ${reel.bg}`,
  `--wash: ${reel.wash}`,
  `--photo-pos: ${reel.pos}`,
  `--photo-filter: ${photoFilter}`,
].join('; ');
---

<section
  class="screen screen--reel"
  id={`screen-${index}`}
  data-screen
  data-active="false"
  style={vars}
  aria-label={`Reel ${reel.num} of ${reels.length} — ${reel.label}`}
>
  <div class="osd" aria-hidden={osdHidden}>
    <span class="osd__num">reel {reel.num} / {String(reels.length).padStart(2, '0')}</span>
    <span class="osd__tc">{reel.tc}</span>
  </div>

  <div class="frame">
    {/*
      The source is 1080×1080 and the top of the srcset says so, which is what
      a high-density screen gets. An ordinary one picks 400 or 720 from
      `sizes` — it does not fetch all three. Eager on reel 01 only: it is the
      first thing after the title card and worth having ready.
    */}
    <Image
      class="frame__photo"
      src={reel.photo}
      alt={reel.alt}
      width={1080}
      widths={[400, 720, 1080]}
      sizes="(min-width: 900px) min(62vw, 720px), 100vw"
      loading={index === 1 ? 'eager' : 'lazy'}
      decoding="async"
    />

    <div class="frame__scan" aria-hidden="true"></div>
    <div class="frame__wash" aria-hidden="true"></div>
    {/* Sinks the bottom of the photograph so the caption stays readable. */}
    <div class="frame__sink" aria-hidden="true"></div>

    <p class="frame__stamp" aria-hidden={osdHidden}>{reel.stamp}</p>

    {reel.frost && <div class="frame__frost" aria-hidden="true" />}

    <div class="caption">
      <h2 class="caption__title">{reel.title}</h2>
      <p class="caption__hand">{reel.hand}</p>
    </div>
  </div>

  <p class="line">{reel.line}</p>

  <ul class="thumbs">
    {
      reel.thumbs.map((thumb) => (
        <li class="thumb">
          <Image
            class="thumb__photo"
            src={thumb.src}
            alt={thumb.alt}
            width={400}
            widths={[200, 400]}
            sizes="(min-width: 900px) 22vw, 44vw"
            loading="lazy"
            decoding="async"
          />
          <div class="thumb__scan" aria-hidden="true" />
        </li>
      ))
    }
  </ul>
</section>

<style>
  .screen--reel {
    background: var(--reel-bg);
  }

  /* ------------------------------------------------------------------ osd */

  .osd {
    flex: 0 0 auto;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--font-osd);
    font-size: var(--osd-md);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    opacity: var(--osd-op, 0);
  }

  .osd__num,
  .osd__tc {
    white-space: nowrap;
  }

  .osd__tc {
    color: var(--tape-muted);
  }

  /* ---------------------------------------------------------------- frame */

  .frame {
    position: relative;
    flex: 1 1 auto;
    /* Without this the photo's intrinsic height wins and the reel overflows. */
    min-height: 0;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--tape-panel);
    box-shadow:
      0 20px 50px rgb(0 0 0 / 66%),
      inset 0 0 0 1px var(--edge);
    transition:
      opacity 0.55s ease,
      transform 0.7s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  /*
   * Reels not in front sit back and dim. Gated on `html.js` because nothing
   * updates `data-active` without it — see the note in tape.css.
   */
  :global(html.js) .screen--reel[data-active='false'] .frame {
    opacity: 0.42;
    transform: scale(0.955);
  }

  /*
   * The photograph is 8% oversized inside a 4% negative inset. That margin is
   * what lets it drift against its frame as you move along the tape — a
   * cheap parallax that reads like the camera panning. `--dist` is how many
   * screens away this reel is; the script sets it, and 0 is a safe default.
   */
  .frame__photo {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    object-position: var(--photo-pos);
    filter: var(--photo-filter);
    transform: translateX(calc(var(--dist, 0) * 10px));
    transition: transform 0.8s cubic-bezier(0.2, 0.8, 0.3, 1);
  }

  .frame__scan,
  .frame__wash,
  .frame__sink,
  .frame__frost {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .frame__scan {
    background: var(--scanline);
    opacity: var(--scan-op, 0);
  }

  .frame__wash {
    background: var(--wash);
    mix-blend-mode: screen;
    opacity: var(--wash-op, 0.3);
  }

  .frame__sink {
    background: linear-gradient(
      to top,
      rgb(8 4 13 / 93%) 0%,
      rgb(8 4 13 / 36%) 36%,
      transparent 64%
    );
  }

  /* Reel 02 only: mist coming off the cold. */
  .frame__frost {
    background: radial-gradient(90% 70% at 50% 100%, rgb(62 224 232 / 50%), transparent 70%);
    opacity: 0.14;
  }

  @media (prefers-reduced-motion: no-preference) {
    .frame__frost {
      animation: tape-frost 7s ease-in-out infinite;
    }
  }

  .frame__stamp {
    position: absolute;
    left: 12px;
    top: 10px;
    font-family: var(--font-osd);
    font-size: var(--osd-sm);
    letter-spacing: 0.14em;
    color: #fff;
    text-shadow: 0 1px 3px #000;
    opacity: var(--osd-op, 0);
  }

  /* -------------------------------------------------------------- caption */

  .caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 14px 14px 12px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.3, 1) 0.07s;
  }

  /* The title rises into place as its reel comes to the front. */
  :global(html.js) .screen--reel[data-active='false'] .caption {
    transform: translateY(18px);
  }

  .caption__title {
    font-family: var(--font-display);
    font-size: var(--step-h2);
    font-weight: 400;
    line-height: 0.84;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    color: var(--tape-cream);
    text-shadow:
      2px 0 0 var(--accent),
      -2px 0 0 rgb(62 224 232 / 60%);
    transition: opacity 0.6s ease 0.07s;
  }

  :global(html.js) .screen--reel[data-active='false'] .caption__title {
    opacity: 0.42;
  }

  .caption__hand {
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: var(--step-hand);
    line-height: 1.15;
    color: var(--accent);
    transform: rotate(-1.2deg);
  }

  /* ----------------------------------------------------------- below deck */

  .line {
    flex: 0 0 auto;
    max-width: 46ch;
    font-family: var(--font-osd);
    font-size: var(--step-body);
    line-height: 1.4;
    letter-spacing: 0.03em;
    color: var(--tape-body);
  }

  /* Two supporting frames, contact-sheet style. */
  .thumbs {
    flex: 0 0 auto;
    display: flex;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .thumb {
    position: relative;
    flex: 1 1 0;
    aspect-ratio: 4 / 3;
    border-radius: 2px;
    overflow: hidden;
    background-color: #120a1a;
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 14%);
  }

  .thumb__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.35) contrast(1.05) brightness(0.86);
  }

  .thumb__scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 40%) 0 1px, transparent 1px 3px);
    opacity: var(--scan-op, 0);
  }

  /*
   * A landscape phone has no room for these, and the photograph above earns
   * the space more than they do.
   */
  @media (max-height: 700px) {
    .thumbs {
      display: none;
    }
  }
</style>
