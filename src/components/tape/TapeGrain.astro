---
import { look } from '../../data/tape';

/*
 * The three layers of wear that sit over everything, including the chrome.
 *
 * All decorative, all pointer-transparent, none of them carrying meaning —
 * so reduced motion can stop the grain shifting and lose nothing but the
 * shimmer.
 *
 * The noise is an inline SVG turbulence filter as a data URI rather than a
 * PNG: it costs about 200 bytes, needs no extra request, and scales to any
 * screen density without going soft.
 */
const grainOpacity = Math.min(Math.max(look.grain, 0), 80) / 100;

const noise =
  "url('data:image/svg+xml;utf8," +
  '<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22140%22 height=%22140%22>' +
  '<filter id=%22n%22><feTurbulence type=%22fractalNoise%22 baseFrequency=%220.9%22 numOctaves=%223%22/></filter>' +
  "<rect width=%22140%22 height=%22140%22 filter=%22url(%23n)%22/></svg>')";
---

<div class="grain" aria-hidden="true" style={`--grain-op: ${grainOpacity}; --noise: ${noise}`}>
</div>
<div class="scan" aria-hidden="true"></div>
<div class="band" aria-hidden="true"></div>

<style>
  /*
   * Fixed, for the same reason as the chrome: on a phone the tape is eleven
   * screens tall and the document scrolls, so an absolute overlay would sit over
   * the first reel only and scroll away with it. The wear has to stay on the
   * glass.
   */
  .grain,
  .scan,
  .band {
    position: fixed;
    z-index: 7;
    pointer-events: none;
  }

  /*
   * Oversized on every side so the drift below never pulls an untextured
   * edge into view.
   */
  .grain {
    inset: -20%;
    opacity: var(--grain-op, 0);
    mix-blend-mode: overlay;
    background-image: var(--noise);
  }

  @media (prefers-reduced-motion: no-preference) {
    .grain {
      animation: tape-grain 0.5s steps(3) infinite;
    }
  }

  .scan {
    inset: 0;
    z-index: 8;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 16%) 0 2px, transparent 2px 4px);
    opacity: var(--scan-op, 0);
  }

  /*
   * The torn strip of noise along the bottom edge of a worn tape, where the
   * playback head switches fields. Full VHS grade only.
   */
  .band {
    left: 0;
    right: 0;
    bottom: 0;
    height: 24px;
    z-index: 9;
    background: repeating-linear-gradient(
      to bottom,
      rgb(255 255 255 / 10%) 0 1px,
      rgb(0 0 0 / 34%) 1px 2px
    );
    filter: blur(0.6px);
    opacity: var(--band-op, 0);
  }
</style>
