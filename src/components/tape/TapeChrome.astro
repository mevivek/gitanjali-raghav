---
import { screenCount, sound, timecode } from '../../data/tape';

/*
 * Everything that floats over the tape rather than travelling with it: the
 * progress segments, and the transport at the bottom.
 *
 * Two indicators, one per orientation. The bar across the top belongs to the
 * wide layout where the tape runs sideways; the rail up the right-hand edge
 * belongs to the phone, where it reads as tape remaining. Only one is ever
 * displayed.
 */
const segments = Array.from({ length: screenCount }, (_, i) => i);
---

<div class="bar" aria-hidden="true">
  {segments.map((i) => <span class="seg" data-seg={i} data-state={i === 0 ? 'now' : 'todo'} />)}
</div>

<div class="rail" aria-hidden="true">
  {segments.map((i) => <span class="seg" data-seg={i} data-state={i === 0 ? 'now' : 'todo'} />)}
</div>

<div class="transport">
  {/*
    These two do need script — "one back from wherever you are" is not
    something an anchor can express. They are hidden until the inline script
    in Base.astro adds `.js`, so they never appear as dead controls. The tape
    is a scroll container, so without them it still swipes, scrolls, and takes
    arrow keys; and the play, resume and rewind anchors on the cards are all
    real links.
  */}
  <button class="key" type="button" data-tape-prev aria-label="Previous reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9650;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9664;&#9664;</span>
  </button>

  <p class="counter">
    <span class="sr-only">Tape position</span>
    <span data-tape-counter>{timecode(0)}</span><span class="counter__caret" aria-hidden="true"
      >_</span
    >
  </p>

  <button class="key" type="button" data-tape-next aria-label="Next reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9660;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9654;&#9654;</span>
  </button>

  {/*
    A slow piano, synthesised in the browser rather than served as a file. This
    replaced a hiss-and-hum bed that was faithful to a cassette and tiring to
    sit under.

    Nothing is committed and nothing needs licensing, which is the point twice
    over: the soundtrack this tape claims is commercial Hindi film music, which
    cannot go on a public page, and what plays instead is four chords with some
    drift rather than a tune, so there is no melody to have borrowed either.

    Silent until pressed. Browsers block autoplay anyway, and WCAG 1.4.2 wants
    a control for anything over three seconds — so the control *is* the only
    way it ever starts, and the choice is remembered.
  */}
  <button
    class="key key--sound"
    type="button"
    aria-pressed="false"
    aria-label={sound.toggleLabel}
    title={sound.toggleLabel}
    data-tape-sound
    data-sound={JSON.stringify(sound)}
  >
    {/*
      A music note rather than a speaker emoji: an emoji renders in full colour
      from the system font and breaks the row of monochrome transport glyphs
      beside it. The state is carried by the button's lit/unlit face for sighted
      users and by the text below for everyone else, so the glyph itself does
      not need to change.
    */}
    <span class="key__glyph" aria-hidden="true">&#9834;</span>
    <span class="sr-only" data-tape-sound-state>{sound.offLabel}</span>
  </button>
</div>

<style>
  /* -------------------------------------------------------------- segments */

  .bar,
  .rail {
    position: absolute;
    z-index: 6;
    pointer-events: none;
  }

  .bar {
    left: 0;
    right: 0;
    top: 0;
    display: none;
    gap: 3px;
    padding: var(--pad-bar);
    /* Clear of the notch, for the same reason as the transport. */
    padding-top: max(11px, env(safe-area-inset-top));
    /* The bar is part of the on-screen display; the rail is not. */
    opacity: var(--osd-op, 0);
  }

  .rail {
    right: max(7px, env(safe-area-inset-right));
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .bar .seg {
    flex: 1 1 0;
    height: 3px;
  }

  .rail .seg {
    width: 3px;
    height: 16px;
  }

  .seg {
    border-radius: 2px;
    background-color: rgb(255 255 255 / 14%);
    transition: background-color 0.35s ease;
  }

  .seg[data-state='seen'] {
    background-color: rgb(255 197 61 / 55%);
  }

  .seg[data-state='now'] {
    background-color: var(--tape-pink);
  }

  @media (min-width: 900px) {
    .bar {
      display: flex;
    }

    .rail {
      display: none;
    }
  }

  /* ------------------------------------------------------------- transport */

  .transport {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: var(--pad-transport);
    /*
     * Lifted clear of the home indicator. Since `viewport-fit=cover` the page
     * extends under it, and these are the one thing on the tape you have to be
     * able to hit accurately.
     */
    padding-bottom: max(16px, env(safe-area-inset-bottom));
    background: linear-gradient(to top, rgb(8 4 13 / 92%), transparent);
    /* The gradient is decoration; only the controls inside should take input. */
    pointer-events: none;
  }

  .transport > * {
    pointer-events: auto;
  }

  .key,
  .counter {
    border: 1px solid var(--tape-edge);
    border-radius: 3px;
    background-color: rgb(20 10 28 / 82%);
    backdrop-filter: blur(6px);
    font-family: var(--font-osd);
  }

  .key {
    width: 44px;
    height: 44px;
    display: none;
    place-items: center;
    color: var(--tape-body);
    font-size: var(--osd-lg);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dead without script, so absent without script. */
  :global(html.js) .key {
    display: grid;
  }

  [data-tape-prev]:hover {
    border-color: var(--tape-cyan);
    color: var(--tape-cyan);
  }

  [data-tape-next]:hover {
    border-color: var(--tape-pink);
    color: var(--tape-pink);
  }

  .key--sound:hover {
    border-color: var(--tape-gold);
    color: var(--tape-gold);
  }

  /* Lit while it is making noise, so the source of the sound is obvious. */
  .key--sound[aria-pressed='true'] {
    border-color: var(--tape-gold);
    background-color: rgb(255 197 61 / 18%);
    color: var(--tape-gold);
  }

  /*
   * Turned on last visit, but not yet this one — nothing may make noise before
   * a gesture. A dim outline says "this is where it was" without pretending it
   * is playing.
   */
  .key--sound.key--armed:not([aria-pressed='true']) {
    border-color: rgb(255 197 61 / 45%);
    color: rgb(255 197 61 / 70%);
  }

  .key__glyph--wide {
    display: none;
  }

  @media (min-width: 900px) {
    .key__glyph--narrow {
      display: none;
    }

    .key__glyph--wide {
      display: inline;
    }
  }

  .counter {
    min-width: 112px;
    padding: 11px 10px;
    text-align: center;
    font-size: var(--osd-lg);
    letter-spacing: 0.16em;
    color: var(--tape-gold);
  }

  .counter__caret {
    color: var(--tape-pink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .counter__caret {
      animation: tape-blink 1.1s steps(1) infinite;
    }
  }
</style>

<script>
  /*
   * Levels arrive on a data attribute rather than by importing src/data/tape.ts.
   * That module imports fifteen photographs, and pulling it into the client
   * bundle's graph makes the build emit all fifteen originals as assets — 2.6MB
   * of files nothing references — even though Vite tree-shakes the bindings
   * back out of the JS.
   */
  const button = document.querySelector<HTMLButtonElement>('[data-tape-sound]');

  if (button) {
    const sound = JSON.parse(button.dataset.sound ?? '{}') as {
      onLabel: string;
      offLabel: string;
      gain: number;
      step: number;
      progression: number[][];
      sparkle: number;
      decay: number;
      detune: number;
      openHz: number;
      closeHz: number;
      reverbTime: number;
      reverbFeedback: number;
      reverbTone: number;
      reverbMix: number;
    };
    const state = button.querySelector<HTMLElement>('[data-tape-sound-state]')!;
    const KEY = 'tape-sound';

    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    /** Where notes are played into: dry to the output, and into the room. */
    let voice: GainNode | null = null;
    let on = false;
    /** The scheduler's clock, and how far through the progression it is. */
    let nextAt = 0;
    let cursor = 0;
    let pumping: number | null = null;

    /**
     * Built on first press, never before: constructing an AudioContext outside
     * a user gesture leaves it suspended and logs an autoplay warning, and
     * building one at all costs an audio thread nobody asked for.
     *
     * Sets up the output and the room only. Notes are made per strike in
     * `pluck` and thrown away afterwards, which is how Web Audio expects
     * oscillators to be used — they are single-use by design.
     */
    function build() {
      const context = new (window.AudioContext ||
        (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();

      const out = context.createGain();
      out.gain.value = 0;
      out.connect(context.destination);

      /*
       * A room, made with a feedback delay rather than a convolver: an impulse
       * response would be another file to fetch and licence, and for a wash
       * this soft the difference is inaudible. The lowpass inside the loop is
       * what stops it turning metallic as it repeats.
       */
      const bus = context.createGain();
      const delay = context.createDelay(1);
      delay.delayTime.value = sound.reverbTime;

      const feedback = context.createGain();
      feedback.gain.value = sound.reverbFeedback;

      const damp = context.createBiquadFilter();
      damp.type = 'lowpass';
      damp.frequency.value = sound.reverbTone;

      const wet = context.createGain();
      wet.gain.value = sound.reverbMix;

      delay.connect(damp);
      damp.connect(feedback);
      feedback.connect(delay);
      damp.connect(out);

      bus.connect(out);
      bus.connect(wet);
      wet.connect(delay);

      ctx = context;
      master = out;
      voice = bus;
    }

    /** MIDI note number to hertz, A4 = 69 = 440Hz. */
    const hz = (midi: number) => 440 * 2 ** ((midi - 69) / 12);

    /**
     * One struck note. There is no piano sample here — it is a triangle for the
     * body plus a quiet sine an octave up for the strike, run through a filter
     * that closes as the note decays. Real strings lose their brightness before
     * they lose their volume, and imitating that is most of what sells it.
     */
    function pluck(midi: number, at: number, velocity = 1) {
      if (!ctx || !voice) return;

      const env = ctx.createGain();
      env.gain.setValueAtTime(0, at);
      env.gain.linearRampToValueAtTime(0.22 * velocity, at + 0.006);
      env.gain.exponentialRampToValueAtTime(0.0001, at + sound.decay);

      const tone = ctx.createBiquadFilter();
      tone.type = 'lowpass';
      tone.frequency.setValueAtTime(sound.openHz, at);
      tone.frequency.exponentialRampToValueAtTime(sound.closeHz, at + sound.decay * 0.8);

      const body = ctx.createOscillator();
      body.type = 'triangle';
      body.frequency.value = hz(midi);
      // A few cents either way, so no two notes are quite the same.
      body.detune.value = (Math.random() * 2 - 1) * sound.detune;

      const strike = ctx.createOscillator();
      strike.type = 'sine';
      strike.frequency.value = hz(midi) * 2;

      const strikeLevel = ctx.createGain();
      strikeLevel.gain.value = 0.3;

      body.connect(tone);
      strike.connect(strikeLevel);
      strikeLevel.connect(tone);
      tone.connect(env);
      env.connect(voice);

      const until = at + sound.decay + 0.1;
      body.start(at);
      strike.start(at);
      body.stop(until);
      strike.stop(until);
    }

    /*
     * Notes are scheduled a little ahead of the clock rather than fired by a
     * timer. setTimeout drifts by tens of milliseconds under load, which on
     * something this exposed is audible as an unsteady hand; the audio clock
     * does not drift, so each note is booked against it in advance.
     */
    function pump() {
      if (!ctx) return;
      while (nextAt < ctx.currentTime + 0.6) {
        const chord = sound.progression[Math.floor(cursor / 4) % sound.progression.length];
        const note = chord[cursor % 4];

        pluck(note, nextAt);
        // An occasional octave up, slightly late, so the loop keeps moving.
        if (Math.random() < sound.sparkle) pluck(note + 12, nextAt + 0.11, 0.45);

        // ±4% on the gap. Metronomic would sound like a machine, which it is.
        nextAt += sound.step * (0.96 + Math.random() * 0.08);
        cursor += 1;
      }
    }

    /** Ramped rather than switched — a hard gate clicks audibly. */
    function level(to: number) {
      if (!ctx || !master) return;
      const now = ctx.currentTime;
      master.gain.cancelScheduledValues(now);
      master.gain.setValueAtTime(master.gain.value, now);
      master.gain.linearRampToValueAtTime(to, now + 0.6);
    }

    async function set(next: boolean) {
      on = next;
      button!.setAttribute('aria-pressed', String(on));
      state.textContent = on ? sound.onLabel : sound.offLabel;

      try {
        localStorage.setItem(KEY, on ? 'on' : 'off');
      } catch {
        /* private mode — the choice just will not persist */
      }

      if (!on) {
        level(0);
        // Stop booking notes, but let the ones already ringing fade out rather
        // than cutting them dead — 0.9s covers the gain ramp and the room.
        if (pumping !== null) {
          clearInterval(pumping);
          pumping = null;
        }
        window.setTimeout(() => {
          if (!on && ctx && ctx.state === 'running') ctx.suspend();
        }, 900);
        return;
      }

      if (!ctx) build();
      // Safari hands back a suspended context even inside a gesture.
      if (ctx && ctx.state === 'suspended') await ctx.resume();

      // Pick up half a beat from now, not from wherever the clock has got to.
      if (ctx) nextAt = Math.max(nextAt, ctx.currentTime + 0.15);
      if (pumping === null) pumping = window.setInterval(pump, 60);
      pump();

      level(sound.gain);
    }

    button.addEventListener('click', () => set(!on));

    /*
     * A remembered "on" is deliberately *not* restored here. It cannot be —
     * there is no gesture yet, so the context would be blocked — and it should
     * not be: arriving at a page that starts making noise is exactly what the
     * autoplay rules exist to prevent. What the stored value does is let the
     * button show the right face, so someone who turned it on last time is one
     * press from it rather than hunting.
     *
     * Reduced motion is treated as a request for less sensory load generally,
     * so the invitation is not even shown in that case.
     */
    try {
      const stored = localStorage.getItem(KEY);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (stored === 'on' && !reduce) button.classList.add('key--armed');
    } catch {
      /* nothing to restore */
    }
  }
</script>
