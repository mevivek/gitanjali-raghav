---
import { screenCount, sound, timecode } from '../../data/tape';

/*
 * Everything that floats over the tape rather than travelling with it: the
 * progress segments, and the transport at the bottom.
 *
 * Two indicators, one per orientation. The bar across the top belongs to the
 * wide layout where the tape runs sideways; the rail up the right-hand edge
 * belongs to the phone, where it reads as tape remaining. Only one is ever
 * displayed.
 */
const segments = Array.from({ length: screenCount }, (_, i) => i);
---

<div class="bar" aria-hidden="true">
  {segments.map((i) => <span class="seg" data-seg={i} data-state={i === 0 ? 'now' : 'todo'} />)}
</div>

<div class="rail" aria-hidden="true">
  {segments.map((i) => <span class="seg" data-seg={i} data-state={i === 0 ? 'now' : 'todo'} />)}
</div>

<div class="transport">
  {/*
    These two do need script — "one back from wherever you are" is not
    something an anchor can express. They are hidden until the inline script
    in Base.astro adds `.js`, so they never appear as dead controls. The tape
    is a scroll container, so without them it still swipes, scrolls, and takes
    arrow keys; and the play, resume and rewind anchors on the cards are all
    real links.
  */}
  <button class="key" type="button" data-tape-prev aria-label="Previous reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9650;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9664;&#9664;</span>
  </button>

  <p class="counter">
    <span class="sr-only">Tape position</span>
    <span data-tape-counter>{timecode(0)}</span><span class="counter__caret" aria-hidden="true"
      >_</span
    >
  </p>

  <button class="key" type="button" data-tape-next aria-label="Next reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9660;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9654;&#9654;</span>
  </button>

  {/*
    The tape's own noise — head hiss, transport hum, a capstan wobble —
    synthesised in the browser rather than served as a file. Nothing is
    committed and nothing needs licensing, which is the point: the soundtrack
    this tape claims is commercial Hindi film music, which cannot go on a
    public page. What a cassette sounds like can.

    Silent until pressed. Browsers block autoplay anyway, and WCAG 1.4.2 wants
    a control for anything over three seconds — so the control *is* the only
    way it ever starts, and the choice is remembered.
  */}
  <button
    class="key key--sound"
    type="button"
    aria-pressed="false"
    aria-label={sound.toggleLabel}
    title={sound.toggleLabel}
    data-tape-sound
    data-sound={JSON.stringify(sound)}
  >
    {/*
      A music note rather than a speaker emoji: an emoji renders in full colour
      from the system font and breaks the row of monochrome transport glyphs
      beside it. The state is carried by the button's lit/unlit face for sighted
      users and by the text below for everyone else, so the glyph itself does
      not need to change.
    */}
    <span class="key__glyph" aria-hidden="true">&#9834;</span>
    <span class="sr-only" data-tape-sound-state>{sound.offLabel}</span>
  </button>
</div>

<style>
  /* -------------------------------------------------------------- segments */

  .bar,
  .rail {
    position: absolute;
    z-index: 6;
    pointer-events: none;
  }

  .bar {
    left: 0;
    right: 0;
    top: 0;
    display: none;
    gap: 3px;
    padding: var(--pad-bar);
    /* The bar is part of the on-screen display; the rail is not. */
    opacity: var(--osd-op, 0);
  }

  .rail {
    right: 7px;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .bar .seg {
    flex: 1 1 0;
    height: 3px;
  }

  .rail .seg {
    width: 3px;
    height: 16px;
  }

  .seg {
    border-radius: 2px;
    background-color: rgb(255 255 255 / 14%);
    transition: background-color 0.35s ease;
  }

  .seg[data-state='seen'] {
    background-color: rgb(255 197 61 / 55%);
  }

  .seg[data-state='now'] {
    background-color: var(--tape-pink);
  }

  @media (min-width: 900px) {
    .bar {
      display: flex;
    }

    .rail {
      display: none;
    }
  }

  /* ------------------------------------------------------------- transport */

  .transport {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: var(--pad-transport);
    background: linear-gradient(to top, rgb(8 4 13 / 92%), transparent);
    /* The gradient is decoration; only the controls inside should take input. */
    pointer-events: none;
  }

  .transport > * {
    pointer-events: auto;
  }

  .key,
  .counter {
    border: 1px solid var(--tape-edge);
    border-radius: 3px;
    background-color: rgb(20 10 28 / 82%);
    backdrop-filter: blur(6px);
    font-family: var(--font-osd);
  }

  .key {
    width: 44px;
    height: 44px;
    display: none;
    place-items: center;
    color: var(--tape-body);
    font-size: var(--osd-lg);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dead without script, so absent without script. */
  :global(html.js) .key {
    display: grid;
  }

  [data-tape-prev]:hover {
    border-color: var(--tape-cyan);
    color: var(--tape-cyan);
  }

  [data-tape-next]:hover {
    border-color: var(--tape-pink);
    color: var(--tape-pink);
  }

  .key--sound:hover {
    border-color: var(--tape-gold);
    color: var(--tape-gold);
  }

  /* Lit while it is making noise, so the source of the sound is obvious. */
  .key--sound[aria-pressed='true'] {
    border-color: var(--tape-gold);
    background-color: rgb(255 197 61 / 18%);
    color: var(--tape-gold);
  }

  /*
   * Turned on last visit, but not yet this one — nothing may make noise before
   * a gesture. A dim outline says "this is where it was" without pretending it
   * is playing.
   */
  .key--sound.key--armed:not([aria-pressed='true']) {
    border-color: rgb(255 197 61 / 45%);
    color: rgb(255 197 61 / 70%);
  }

  .key__glyph--wide {
    display: none;
  }

  @media (min-width: 900px) {
    .key__glyph--narrow {
      display: none;
    }

    .key__glyph--wide {
      display: inline;
    }
  }

  .counter {
    min-width: 112px;
    padding: 11px 10px;
    text-align: center;
    font-size: var(--osd-lg);
    letter-spacing: 0.16em;
    color: var(--tape-gold);
  }

  .counter__caret {
    color: var(--tape-pink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .counter__caret {
      animation: tape-blink 1.1s steps(1) infinite;
    }
  }
</style>

<script>
  /*
   * Levels arrive on a data attribute rather than by importing src/data/tape.ts.
   * That module imports fifteen photographs, and pulling it into the client
   * bundle's graph makes the build emit all fifteen originals as assets — 2.6MB
   * of files nothing references — even though Vite tree-shakes the bindings
   * back out of the JS.
   */
  const button = document.querySelector<HTMLButtonElement>('[data-tape-sound]');

  if (button) {
    const sound = JSON.parse(button.dataset.sound ?? '{}') as {
      onLabel: string;
      offLabel: string;
      gain: number;
      hissHz: number;
      humHz: number;
      humGain: number;
      wobbleHz: number;
      wobbleDepth: number;
    };
    const state = button.querySelector<HTMLElement>('[data-tape-sound-state]')!;
    const KEY = 'tape-sound';

    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    let on = false;

    /**
     * Built on first press, never before: constructing an AudioContext outside
     * a user gesture leaves it suspended and logs an autoplay warning, and
     * building one at all costs an audio thread nobody asked for.
     *
     * Three voices, which is what a cassette deck actually gives you:
     *   hiss   — white noise through a low-pass, the tape head
     *   hum    — a 50Hz sine, the transport motor (these ran off mains)
     *   wobble — a slow LFO on the master gain, the capstan not quite true
     */
    function build() {
      const context = new (window.AudioContext ||
        (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext)();

      const out = context.createGain();
      out.gain.value = 0;
      out.connect(context.destination);

      // Two seconds of noise, looped. Long enough that the loop is inaudible.
      const frames = context.sampleRate * 2;
      const buffer = context.createBuffer(1, frames, context.sampleRate);
      const channel = buffer.getChannelData(0);
      for (let i = 0; i < frames; i += 1) channel[i] = Math.random() * 2 - 1;

      const hiss = context.createBufferSource();
      hiss.buffer = buffer;
      hiss.loop = true;

      const shelf = context.createBiquadFilter();
      shelf.type = 'lowpass';
      shelf.frequency.value = sound.hissHz;

      hiss.connect(shelf).connect(out);

      const hum = context.createOscillator();
      hum.type = 'sine';
      hum.frequency.value = sound.humHz;

      const humLevel = context.createGain();
      humLevel.gain.value = sound.humGain;
      hum.connect(humLevel).connect(out);

      const wobble = context.createOscillator();
      wobble.type = 'sine';
      wobble.frequency.value = sound.wobbleHz;

      const wobbleDepth = context.createGain();
      wobbleDepth.gain.value = sound.gain * sound.wobbleDepth;
      wobble.connect(wobbleDepth).connect(out.gain);

      hiss.start();
      hum.start();
      wobble.start();

      ctx = context;
      master = out;
    }

    /** Ramped rather than switched — a hard gate on noise clicks audibly. */
    function level(to: number) {
      if (!ctx || !master) return;
      const now = ctx.currentTime;
      master.gain.cancelScheduledValues(now);
      master.gain.setValueAtTime(master.gain.value, now);
      master.gain.linearRampToValueAtTime(to, now + 0.4);
    }

    async function set(next: boolean) {
      on = next;
      button!.setAttribute('aria-pressed', String(on));
      state.textContent = on ? sound.onLabel : sound.offLabel;

      try {
        localStorage.setItem(KEY, on ? 'on' : 'off');
      } catch {
        /* private mode — the choice just will not persist */
      }

      if (!on) {
        level(0);
        return;
      }

      if (!ctx) build();
      // Safari hands back a suspended context even inside a gesture.
      if (ctx && ctx.state === 'suspended') await ctx.resume();
      level(sound.gain);
    }

    button.addEventListener('click', () => set(!on));

    /*
     * A remembered "on" is deliberately *not* restored here. It cannot be —
     * there is no gesture yet, so the context would be blocked — and it should
     * not be: arriving at a page that starts making noise is exactly what the
     * autoplay rules exist to prevent. What the stored value does is let the
     * button show the right face, so someone who turned it on last time is one
     * press from it rather than hunting.
     *
     * Reduced motion is treated as a request for less sensory load generally,
     * so the invitation is not even shown in that case.
     */
    try {
      const stored = localStorage.getItem(KEY);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (stored === 'on' && !reduce) button.classList.add('key--armed');
    } catch {
      /* nothing to restore */
    }
  }
</script>
