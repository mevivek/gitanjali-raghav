---
import { positions, sound, timecode, wear } from '../../data/tape';

/*
 * Everything that floats over the tape rather than travelling with it: the film
 * furniture on a wide screen, and the transport at the bottom.
 *
 * There used to be two progress indicators here as well — an eleven-segment bar
 * across the top for the wide layout and a matching rail up the right-hand edge
 * of a phone. The third handoff took both out and gave the job to the two spools
 * either side of the counter, which wind between each other as you move along the
 * tape. That is a better fit for the conceit and it fixed something: the bar was
 * gated on `look.osd`, so on a wide screen with the display off there was no
 * indicator at all, while the rail was ungated and always there. One indicator
 * that is always visible replaces two that disagreed.
 */
---

{/*
  Wide only, and both purely scenery: an inner frame around the centre panel,
  and the sprocket holes running along the top and bottom edges. Together they
  are what make the wide layout read as a strip of film through a gate rather
  than a big photograph with slivers either side of it — which is the whole
  reason the panel narrowed to 560px.

  The bezel comes first so the perforations paint over it where they meet.
*/}
<div class="bezel" aria-hidden="true"></div>
<span class="sprocket sprocket--top" aria-hidden="true"></span>
<span class="sprocket sprocket--bottom" aria-hidden="true"></span>

<div class="transport">
  {/*
    These two do need script — "one back from wherever you are" is not
    something an anchor can express. They are hidden until the inline script
    in Base.astro adds `.js`, so they never appear as dead controls. The tape
    is a scroll container, so without them it still swipes, scrolls, and takes
    arrow keys; and the play, resume and rewind anchors on the cards are all
    real links.
  */}
  <button class="key" type="button" data-tape-prev aria-label="Previous reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9650;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9664;&#9664;</span>
  </button>

  {/*
    The counter carries both per-screen tables — where the tape is, and how worn
    each screen is — because the script in index.astro needs them and must not
    import src/data/tape.ts to find out. See the note at the foot of this file.

    The two spools either side are the tape's position indicator, and they replaced
    an eleven-segment bar and rail. `--tape-pos` runs 0 to 1 along the tape and the
    script sets it on the root; the left spool's hub shrinks as the right one's
    grows, which is what a cassette actually does while it plays. `aria-hidden`
    because the timecode between them says the same thing in words.
  */}
  <div class="counter">
    <span class="spool" aria-hidden="true">
      <span class="spool__hub spool__hub--supply"></span>
    </span>

    <p class="counter__read">
      <span class="sr-only">Tape position</span>
      <span
        data-tape-counter
        data-tape-positions={JSON.stringify(positions)}
        data-tape-wear={JSON.stringify(wear)}>{timecode(0)}</span
      ><span class="counter__caret" aria-hidden="true">_</span>
    </p>

    <span class="spool" aria-hidden="true">
      <span class="spool__hub spool__hub--take"></span>
    </span>
  </div>

  <button class="key" type="button" data-tape-next aria-label="Next reel">
    <span class="key__glyph key__glyph--narrow" aria-hidden="true">&#9660;</span>
    <span class="key__glyph key__glyph--wide" aria-hidden="true">&#9654;&#9654;</span>
  </button>

  {/*
    Five short blips, synthesised in the browser: the transport clunk when the
    tape moves, a key click on a control, a tick and a ping on reel 06, and the
    spooling sweep on rewind. Nothing is fetched and nothing is licensed — see
    the note on `sound` in src/data/tape.ts for why that matters twice over.

    Off by default and remembered. Every blip is caused by something the visitor
    did, so a remembered "on" can simply be restored: there is nothing that can
    make a noise before the first gesture, which is what the autoplay rules are
    protecting against.
  */}
  <button
    class="key key--sound"
    type="button"
    aria-pressed="false"
    aria-label={sound.toggleLabel}
    title={sound.toggleLabel}
    data-tape-sound
    data-sound={JSON.stringify(sound)}
  >
    {/*
      A filled or hollow ring rather than a speaker emoji: an emoji renders in
      full colour from the system font and breaks the row of monochrome
      transport glyphs beside it.
    */}
    <span class="key__glyph" aria-hidden="true" data-tape-sound-glyph>&#9675;</span>
    <span class="sr-only" data-tape-sound-state>{sound.offLabel}</span>
  </button>
</div>

<style>
  /* ------------------------------------------------------- film furniture */

  /*
   * Fixed, like everything else that floats over the tape. What matters is that
   * these sit *outside* `.tape__track`, which is the scroller — anything inside
   * it, or positioned against it, would travel with the reels. `.tape` is
   * exactly one viewport tall, so fixed and absolute-within-the-tape describe
   * the same rectangle; fixed says the intent more plainly and does not depend
   * on which ancestor happens to be positioned.
   */
  .bezel,
  .sprocket {
    position: fixed;
    z-index: 5;
    display: none;
    pointer-events: none;
  }

  /* An inner frame, exactly the width of the panel the reels snap to. */
  .bezel {
    top: 0;
    bottom: 0;
    left: calc((100% - var(--panel-w)) / 2);
    right: calc((100% - var(--panel-w)) / 2);
    box-shadow:
      inset 0 0 0 1px rgb(246 239 230 / 14%),
      inset 0 0 40px rgb(0 0 0 / 70%);
  }

  .sprocket {
    left: 0;
    right: 0;
    height: 20px;
    background-color: var(--tape-void);
  }

  /* The perforations themselves — a repeating gradient, not an image. */
  .sprocket::before {
    content: '';
    position: absolute;
    inset: 4px 0;
    background: repeating-linear-gradient(
      to right,
      transparent 0 16px,
      rgb(246 239 230 / 20%) 16px 28px
    );
  }

  .sprocket--top {
    top: 0;
    box-shadow: inset 0 -1px 0 #2e2140;
  }

  .sprocket--bottom {
    bottom: 0;
    box-shadow: inset 0 1px 0 #2e2140;
  }

  @media (min-width: 900px) {
    .bezel,
    .sprocket {
      display: block;
    }
  }

  /* ------------------------------------------------------------- transport */

  .transport {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 6;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: var(--pad-transport);
    /*
     * Lifted clear of the home indicator. Since `viewport-fit=cover` the page
     * extends under it, and these are the one thing on the tape you have to be
     * able to hit accurately.
     */
    padding-bottom: max(16px, env(safe-area-inset-bottom));
    background: linear-gradient(to top, rgb(8 4 13 / 92%), transparent);
    /* The gradient is decoration; only the controls inside should take input. */
    pointer-events: none;
  }

  .transport > * {
    pointer-events: auto;
  }

  .key,
  .counter {
    border: 1px solid var(--tape-edge);
    border-radius: 3px;
    background-color: rgb(20 10 28 / 82%);
    backdrop-filter: blur(6px);
    font-family: var(--font-osd);
  }

  .key {
    width: 44px;
    height: 44px;
    display: none;
    place-items: center;
    color: var(--tape-body);
    font-size: var(--osd-lg);
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dead without script, so absent without script. */
  :global(html.js) .key {
    display: grid;
  }

  [data-tape-prev]:hover {
    border-color: var(--tape-cyan);
    color: var(--tape-cyan);
  }

  [data-tape-next]:hover {
    border-color: var(--tape-pink);
    color: var(--tape-pink);
  }

  .key--sound:hover {
    border-color: var(--tape-cyan);
    color: var(--tape-cyan);
  }

  /* Lit while it is armed, so the source of the noise is obvious. */
  .key--sound[aria-pressed='true'] {
    border-color: var(--tape-cyan);
    color: var(--tape-cyan);
  }

  .key__glyph--wide {
    display: none;
  }

  @media (min-width: 900px) {
    .key__glyph--narrow {
      display: none;
    }

    .key__glyph--wide {
      display: inline;
    }
  }

  .counter {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 8px 12px;
  }

  .counter__read {
    min-width: 92px;
    text-align: center;
    font-family: var(--font-osd);
    font-size: var(--osd-lg);
    letter-spacing: 0.16em;
    color: var(--tape-gold);
    font-variant-numeric: tabular-nums;
  }

  .counter__caret {
    color: var(--tape-pink);
  }

  @media (prefers-reduced-motion: no-preference) {
    .counter__caret {
      animation: tape-blink 1.1s steps(1) infinite;
    }
  }

  /* --------------------------------------------------------------- spools */

  /*
   * The tape's position, and the one indicator that is always visible whatever
   * `look.osd` is set to. The supply spool empties as the take-up spool fills, so
   * how far along you are is legible at a glance without reading the timecode
   * between them — which is what the segment bar and rail used to be for.
   */
  .spool {
    position: relative;
    flex: 0 0 auto;
    width: 22px;
    height: 22px;
    display: grid;
    place-items: center;
    border: 2px dashed rgb(246 239 230 / 32%);
    border-radius: 999px;
  }

  /*
   * The teeth turn, and at different rates, because a playing deck's two spools
   * are never in step. Decoration only — the hub sizes below carry the meaning,
   * so reduced motion loses nothing.
   */
  @media (prefers-reduced-motion: no-preference) {
    .spool:first-child {
      animation: tape-spool 9s linear infinite;
    }

    .spool:last-child {
      animation: tape-spool 13s linear infinite reverse;
    }
  }

  /*
   * `--tape-pos` is 0 at the title card and 1 at the credits; index.astro sets it
   * on the root as the tape moves. 13px is the widest a hub gets, which is just
   * inside the 22px ring.
   */
  .spool__hub {
    border-radius: 999px;
    transition:
      width 0.55s ease,
      height 0.55s ease;
  }

  .spool__hub--supply {
    width: calc(13px * (1 - var(--tape-pos, 0)));
    height: calc(13px * (1 - var(--tape-pos, 0)));
    background-color: rgb(255 197 61 / 85%);
  }

  .spool__hub--take {
    width: calc(13px * var(--tape-pos, 0));
    height: calc(13px * var(--tape-pos, 0));
    background-color: rgb(255 46 136 / 85%);
  }
</style>

<script>
  /*
   * The deck's noises.
   *
   * Levels arrive on a data attribute rather than by importing src/data/tape.ts.
   * That module imports fifteen photographs, and pulling it into the client
   * bundle's graph makes the build emit all fifteen originals as assets — 2.6MB
   * of files nothing references — even though Vite tree-shakes the bindings
   * back out of the JS.
   *
   * The reels do not import this file either. They ask for a blip by dispatching
   * a `tape:blip` event on the document, which means there is no load-order
   * coupling in either direction and no global to collide with: if this script
   * never ran, the event is simply nobody's.
   */
  const button = document.querySelector<HTMLButtonElement>('[data-tape-sound]');

  if (button) {
    type Blip = {
      wave: OscillatorType;
      hz: number;
      toHz?: number;
      glide?: number;
      gain: number;
      decay: number;
    };

    const sound = JSON.parse(button.dataset.sound ?? '{}') as {
      onLabel: string;
      offLabel: string;
      blips: Record<string, Blip>;
      clunk: {
        noiseDur: number;
        noiseCurve: number;
        noiseCutoff: number;
        noiseGain: number;
        thudFrom: number;
        thudTo: number;
        thudGain: number;
        thudDecay: number;
      };
      rewind: {
        dur: number;
        q: number;
        from: number;
        peak: number;
        to: number;
        peakAt: number;
        gain: number;
      };
    };

    const state = button.querySelector<HTMLElement>('[data-tape-sound-state]')!;
    const glyph = button.querySelector<HTMLElement>('[data-tape-sound-glyph]')!;
    const KEY = 'tape-sound';

    let ctx: AudioContext | null = null;
    let on = false;

    /*
     * Whether anything has been pressed yet. Almost every blip is caused by a
     * click, so this is nearly always true by the time one is asked for — but
     * reel 06's metronome ticks on a timer, and building an AudioContext outside
     * a gesture gets it handed back permanently suspended with a warning logged.
     * So a timer-driven blip before the first press is simply skipped.
     */
    let gestured = false;
    const noteGesture = () => {
      gestured = true;
    };
    window.addEventListener('pointerdown', noteGesture, { once: true, capture: true });
    window.addEventListener('keydown', noteGesture, { once: true, capture: true });

    function context(): AudioContext | null {
      if (!ctx) {
        const Ctor =
          window.AudioContext ||
          (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctor) return null;
        ctx = new Ctor();
      }
      // Safari hands one back suspended even inside a gesture.
      if (ctx.state === 'suspended') void ctx.resume();
      return ctx;
    }

    /**
     * A buffer of white noise. `curve` fades it away over its own length, which
     * is what turns a hiss into a burst — 0 leaves it flat.
     */
    function noise(ac: AudioContext, seconds: number, curve = 0) {
      const buffer = ac.createBuffer(1, Math.max(1, Math.floor(ac.sampleRate * seconds)), ac.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < data.length; i += 1) {
        const shape = curve ? (1 - i / data.length) ** curve : 1;
        data[i] = (Math.random() * 2 - 1) * shape;
      }
      const source = ac.createBufferSource();
      source.buffer = buffer;
      return source;
    }

    /** One oscillator with a falling envelope. Optionally glides in pitch. */
    function tone(ac: AudioContext, spec: Blip) {
      const at = ac.currentTime;
      const env = ac.createGain();
      env.connect(ac.destination);

      const osc = ac.createOscillator();
      osc.type = spec.wave;
      osc.frequency.setValueAtTime(spec.hz, at);
      if (spec.toHz) osc.frequency.exponentialRampToValueAtTime(spec.toHz, at + (spec.glide ?? 0.07));

      env.gain.setValueAtTime(spec.gain, at);
      env.gain.exponentialRampToValueAtTime(0.0004, at + spec.decay);

      osc.connect(env);
      osc.start(at);
      osc.stop(at + spec.decay + 0.03);
    }

    /** The transport: a dull filtered burst over a falling thud. */
    function clunk(ac: AudioContext) {
      const c = sound.clunk;
      const at = ac.currentTime;

      const burst = noise(ac, c.noiseDur, c.noiseCurve);
      const damp = ac.createBiquadFilter();
      damp.type = 'lowpass';
      damp.frequency.value = c.noiseCutoff;

      const env = ac.createGain();
      env.gain.setValueAtTime(c.noiseGain, at);
      env.gain.exponentialRampToValueAtTime(0.001, at + c.noiseDur + 0.01);

      burst.connect(damp);
      damp.connect(env);
      env.connect(ac.destination);
      burst.start(at);

      const thud = ac.createOscillator();
      thud.type = 'sine';
      thud.frequency.setValueAtTime(c.thudFrom, at);
      thud.frequency.exponentialRampToValueAtTime(c.thudTo, at + c.thudDecay * 0.87);

      const thudEnv = ac.createGain();
      thudEnv.gain.setValueAtTime(c.thudGain, at);
      thudEnv.gain.exponentialRampToValueAtTime(0.001, at + c.thudDecay);

      thud.connect(thudEnv);
      thudEnv.connect(ac.destination);
      thud.start(at);
      thud.stop(at + c.thudDecay + 0.03);
    }

    /** Rewind: bandpassed noise swept up and back down, like spooling tape. */
    function rewind(ac: AudioContext) {
      const r = sound.rewind;
      const at = ac.currentTime;

      const hiss = noise(ac, r.dur);
      const band = ac.createBiquadFilter();
      band.type = 'bandpass';
      band.Q.value = r.q;
      band.frequency.setValueAtTime(r.from, at);
      band.frequency.linearRampToValueAtTime(r.peak, at + r.peakAt);
      band.frequency.linearRampToValueAtTime(r.to, at + r.dur - 0.02);

      const env = ac.createGain();
      env.gain.setValueAtTime(0.001, at);
      env.gain.linearRampToValueAtTime(r.gain, at + 0.1);
      env.gain.linearRampToValueAtTime(0.0008, at + r.dur);

      hiss.connect(band);
      band.connect(env);
      env.connect(ac.destination);
      hiss.start(at);
    }

    function blip(kind: string) {
      if (!on) return;
      // Nothing before the first press — see the note on `gestured`.
      if (!ctx && !gestured) return;

      const ac = context();
      if (!ac) return;

      if (kind === 'clunk') return clunk(ac);
      if (kind === 'rewind') return rewind(ac);

      const spec = sound.blips[kind];
      if (spec) tone(ac, spec);
    }

    function paint() {
      button!.setAttribute('aria-pressed', String(on));
      state.textContent = on ? sound.onLabel : sound.offLabel;
      // Filled while it is on, hollow while it is not.
      glyph.textContent = on ? '●' : '○';
    }

    function set(next: boolean) {
      on = next;
      paint();

      try {
        localStorage.setItem(KEY, on ? 'on' : 'off');
      } catch {
        /* private mode — the choice just will not persist */
      }

      // The deck confirming itself, which is also the proof that it works.
      if (on) blip('clunk');
      else if (ctx && ctx.state === 'running') void ctx.suspend();
    }

    button.addEventListener('click', () => set(!on));

    /* The reels' only way in. */
    document.addEventListener('tape:blip', (event) => {
      blip(String((event as CustomEvent).detail ?? ''));
    });

    /*
     * A remembered "on" is restored outright, which the piano this replaced
     * could not be: it started playing by itself, so it had to wait for a
     * gesture and the button showed a half-lit "armed" face in the meantime.
     * Blips only ever answer something the visitor did, so there is nothing to
     * wait for — the state is simply the state.
     */
    try {
      if (localStorage.getItem(KEY) === 'on') {
        on = true;
        paint();
      }
    } catch {
      /* nothing to restore */
    }
  }
</script>
