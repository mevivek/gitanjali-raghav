---
import { look, qualityCheck, slugs } from '../../data/tape';

interface Props {
  /** Position on the strip. */
  index: number;
}

const { index } = Astro.props;

const osdHidden = look.osd ? undefined : true;

const total = qualityCheck.checks.length;
const passes = qualityCheck.checks.filter((check) => check.verdict === 'pass').length;

const fill = (template: string, values: Record<string, number>) =>
  template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''));

/* What the summary says before anything is examined, and with everything done. */
const summaryIdle = fill(qualityCheck.summaryPartial, { done: 0, total });
const summaryAll = fill(qualityCheck.summaryAll, {
  pass: passes,
  fail: total - passes,
});
---

<section
  class="screen screen--qc screen--flat"
  id={slugs[index]}
  data-screen
  data-active="false"
  data-qc
  data-copy={JSON.stringify({
    total,
    summaryPartial: qualityCheck.summaryPartial,
    summaryAll: qualityCheck.summaryAll,
    signedPending: qualityCheck.signedPending,
    signedDone: qualityCheck.signedDone,
  })}
  aria-label="Interval, b-side — the certificate"
>
  <div class="reel__osd" aria-hidden={osdHidden}>
    <span>{qualityCheck.kicker}</span>
    <span class="reel__osd-tc">{qualityCheck.tc}</span>
  </div>

  {/*
    The card the censor board staples to the front of a print, made out to
    herself. It was a carbon-paper QA form until the third handoff; a certificate
    is the same joke on better stationery, and it is the thing every Hindi film
    actually opens on, which is a better fit for a tape than an internal form.

    `data-nodrag` because pressing the stamp on a wide screen must not be read as
    a drag on the tape.
  */}
  <div class="cert" data-nodrag data-done="false">
    <p class="cert__board">
      <span>{qualityCheck.board}</span>
      <span class="cert__rule" aria-hidden="true"></span>
    </p>

    <div class="cert__head">
      <span class="cert__names">
        <h2 class="cert__title">{qualityCheck.heading}</h2>
        <span class="cert__code">
          {qualityCheck.code} &middot;
          {/*
            Two spellings of the same fact, because the no-script page has every
            condition already examined and the scripted one starts with none. CSS
            picks one, so neither ever flashes into the other.
          */}
          <span class="only-js" data-qc-signed>{qualityCheck.signedPending}</span>
          <span class="only-static">{qualityCheck.signedDone}</span>
        </span>
      </span>

      {/*
        The rating, boxed. U/A is the real Indian certificate for "parental
        guidance under 12", which is about right for a tape whose worst offence
        is the language on this screen.
      */}
      <span class="rating">
        <span class="rating__mark">{qualityCheck.rating}</span>
        <span class="rating__note">{qualityCheck.ratingNote}</span>
      </span>
    </div>

    <dl class="parts">
      {
        qualityCheck.particulars.map((part) => (
          <div class="part">
            <dt class="part__k">{part.k}</dt>
            <dd class="part__v">{part.v}</dd>
          </div>
        ))
      }
    </dl>

    <div class="conditions">
      <p class="conditions__label">{qualityCheck.conditionsLabel}</p>

      <ul class="rows">
        {
          qualityCheck.checks.map((check, i) => (
            <li class="row" data-qc-row={check.id} data-run="false">
              <span class="row__n">{i + 1}</span>

              <span class="row__body">
                <span class="row__item">{check.item}</span>
                <span class="row__note">{check.note}</span>
              </span>

              {/*
                A real button per line, so a single condition can be examined on
                its own from the keyboard — the "press the stamp" key below only
                ever takes the next one in order. Both are the same action.
              */}
              <button
                class="row__press only-js"
                type="button"
                aria-label={`Examine: ${check.item}`}
                data-qc-run={check.id}
              >
                <span class="row__empty" aria-hidden="true"></span>
              </button>

              <span class="row__stamp" data-verdict={check.verdict}>
                {check.verdict}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cert__foot">
      {/*
        The stamp comes down on the next unexamined line, one press at a time. A
        rubber stamp is a single action, and going through them in order is what
        makes the three fails land one after another instead of as a batch.
      */}
      <button class="cert__press only-js" type="button" data-qc-all>
        {qualityCheck.pressLabel}
      </button>

      <button class="cert__reset only-js" type="button" data-qc-clear>
        {qualityCheck.resetLabel}
      </button>

      {/*
        aria-live so pressing the stamp announces the tally moving, which is the
        only feedback a screen-reader user gets for the impression landing.
      */}
      <p class="cert__summary" aria-live="polite">
        <span class="only-js" data-qc-summary>{summaryIdle}</span>
        <span class="only-static">{summaryAll}</span>
      </p>
    </div>

    <div class="signed">
      <span class="signed__label">{qualityCheck.signedLabel}</span>
      <span class="signed__rule">
        <span class="signed__hand">{qualityCheck.signature}</span>
      </span>
      <span class="signed__date">{qualityCheck.date}</span>
    </div>

    {/*
      Slammed across the card once every condition has been examined. It is
      `aria-hidden` because the summary beside the stamp already says the same
      thing in a form a screen reader can use, and this is the graphic version.
    */}
    <p class="verdict" aria-hidden="true">
      <span class="verdict__top">{qualityCheck.verdictTop}</span>
      <span class="verdict__note">{qualityCheck.verdictNote}</span>
    </p>
  </div>
</section>

<style>
  .screen--qc {
    justify-content: safe center;
    /* See the long note on .screen--interval in tape.css: the internal scroll
       only exists on a short window, because a nested scroller with nothing to
       scroll can still swallow a swipe on iOS. */
    overflow: clip;
    background: radial-gradient(120% 90% at 50% 0%, #16283a 0%, #0c1420 54%, #08040d 100%);
    /* The osd strip on this screen is ice, not a reel accent. */
    --accent: var(--tape-ice);
  }

  /* --------------------------------------------------------- the certificate */

  /*
   * Green-grey security paper with a double rule round it, which is what these
   * cards are actually printed on — deliberately not the warm stock reel 07's
   * inlay card uses. The two are different objects and should not look like the
   * same piece of paper.
   */
  .cert {
    position: relative;
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 15px 16px;
    border: 3px double var(--tape-cert-ink);
    background: linear-gradient(var(--tape-cert), var(--tape-cert-shade));
    box-shadow: 0 18px 44px rgb(0 0 0 / 60%);
    transform: rotate(0.35deg);
    /* The verdict stamp is positioned against this and must not escape it. */
    overflow: hidden;
  }

  .cert__board {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    text-align: center;
    font-family: var(--font-osd);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--tape-cert-faint);
  }

  .cert__rule {
    width: 34px;
    height: 1px;
    margin: 3px 0;
    background-color: rgb(28 42 30 / 45%);
  }

  .cert__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .cert__names {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .cert__title {
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--tape-cert-ink);
  }

  .cert__code {
    font-family: var(--font-osd);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--tape-cert-mute);
  }

  /* ------------------------------------------------------------- the rating */

  .rating {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    padding: 3px 9px 4px;
    border: 2px solid var(--tape-cert-ink);
    border-radius: 2px;
  }

  .rating__mark {
    font-family: var(--font-display);
    font-size: 27px;
    line-height: 0.9;
    color: var(--tape-cert-ink);
  }

  .rating__note {
    font-family: var(--font-osd);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--tape-cert-mute);
  }

  /* -------------------------------------------------------- the particulars */

  /*
   * A two-column list of facts about the print. `display: contents` on the
   * wrapper lets the <dt>/<dd> pairs be the grid's own items and keep their
   * semantics — the same trick the end credits use.
   */
  .parts {
    margin: 0;
    display: grid;
    grid-template-columns: 66px 1fr;
    gap: 2px 9px;
    align-items: baseline;
    padding: 6px 0;
    border-top: 1px solid rgb(28 42 30 / 35%);
    border-bottom: 1px solid rgb(28 42 30 / 35%);
  }

  .part {
    display: contents;
  }

  .part__k {
    font-family: var(--font-osd);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--tape-cert-mute);
  }

  .part__v {
    margin: 0;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-osd);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--tape-cert-ink);
  }

  /* --------------------------------------------------------- the conditions */

  .conditions {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .conditions__label {
    font-family: var(--font-osd);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--tape-cert-faint);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 5px 0;
    border-bottom: 1px solid rgb(28 42 30 / 16%);
  }

  .row__n {
    flex: 0 0 auto;
    width: 15px;
    font-family: var(--font-osd);
    font-size: 13px;
    color: var(--tape-cert-mute);
  }

  .row__body {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }

  /* Faint until it has been examined, then in ink. */
  .row__item {
    font-family: var(--font-osd);
    font-size: 14px;
    line-height: 1.22;
    letter-spacing: 0.02em;
    color: #4c5a49;
    transition: color 0.2s ease;
  }

  .row[data-run='true'] .row__item {
    color: var(--tape-cert-ink);
  }

  /*
   * Her note in the margin. The row keeps its height whether or not the note
   * is showing, so stamping a line does not shunt the rest of the card about.
   */
  .row__note {
    min-height: 18px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--font-hand);
    font-weight: 600;
    font-size: 16px;
    line-height: 1.08;
    color: #a0553f;
    /*
     * Faded in rather than switched on, so the note arrives with the stamp instead
     * of appearing a frame before it. `min-height` above is what keeps the row's
     * height steady either way — opacity alone would not, and `display` would take
     * the reserved space back and shunt the rest of the card as each line lands.
     */
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .row[data-run='true'] .row__note {
    opacity: 1;
  }

  /* An empty ruled box, waiting for an impression. */
  .row__press {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  .row__empty {
    display: block;
    width: 52px;
    height: 22px;
    border: 1px dotted rgb(28 42 30 / 40%);
    border-radius: 2px;
    transition: border-color 0.2s ease;
  }

  .row__press:hover .row__empty {
    border-style: solid;
    border-color: var(--tape-cert-ink);
  }

  /* Examined: the box gives its place up to the stamp. */
  .row[data-run='true'] .row__press {
    display: none;
  }

  .row__stamp {
    flex: 0 0 auto;
    display: none;
    align-items: center;
    justify-content: center;
    width: 52px;
    min-height: 22px;
    border: 2px solid;
    border-radius: 2px;
    font-family: var(--font-osd);
    font-size: 14px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.88;
  }

  .row[data-run='true'] .row__stamp {
    display: inline-flex;
  }

  /*
   * Pass and fail land crooked in opposite directions, so a column of them
   * reads as separate impressions of a rubber stamp rather than one graphic
   * repeated. The animations are declared in global.css.
   */
  .row__stamp[data-verdict='pass'] {
    border-color: var(--tape-cert-ink);
    color: var(--tape-cert-ink);
    animation: tape-stamp-pass 0.34s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
  }

  .row__stamp[data-verdict='fail'] {
    border-color: var(--tape-stamp-fail);
    color: var(--tape-stamp-fail);
    animation: tape-stamp-fail 0.34s cubic-bezier(0.2, 1.4, 0.4, 1) forwards;
  }

  /* ------------------------------------------------------------- the foot */

  .cert__foot {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .cert__press,
  .cert__reset {
    flex: 1 1 auto;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 13px;
    border-radius: 2px;
    font-family: var(--font-osd);
    font-size: 15px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .cert__press {
    border: 0;
    background-color: var(--tape-cert-ink);
    color: var(--tape-cert);
    box-shadow: 0 3px 0 #0d1510;
  }

  .cert__press:hover {
    background-color: var(--tape-stamp-fail);
    box-shadow: 0 3px 0 #7d2a1b;
  }

  /* Travels like a stamp being pressed, because that is what it is. */
  .cert__press:active {
    transform: translateY(2px);
    box-shadow: 0 1px 0 #0d1510;
  }

  .cert__reset {
    border: 1px solid rgb(28 42 30 / 50%);
    background: transparent;
    color: var(--tape-cert-faint);
  }

  .cert__reset:hover {
    border-color: var(--tape-cert-ink);
    color: var(--tape-cert-ink);
  }

  /* Only one of the two is ever the useful one. */
  .cert[data-done='false'] .cert__reset,
  .cert[data-done='true'] .cert__press {
    display: none;
  }

  .cert__summary {
    flex: 0 0 auto;
    text-align: right;
    font-family: var(--font-osd);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tape-cert-mute);
  }

  /* --------------------------------------------------------- the signature */

  .signed {
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }

  .signed__label,
  .signed__date {
    flex: 0 0 auto;
    font-family: var(--font-osd);
    font-size: 10px;
    color: var(--tape-cert-mute);
  }

  .signed__label {
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .signed__date {
    letter-spacing: 0.1em;
  }

  .signed__rule {
    flex: 1 1 auto;
    min-width: 0;
    min-height: 24px;
    display: flex;
    align-items: flex-end;
    border-bottom: 1px solid rgb(28 42 30 / 45%);
    /* Signed only once every condition has been examined. */
    opacity: 0;
    transition: opacity 0.35s ease;
  }

  .cert[data-done='true'] .signed__rule {
    opacity: 1;
  }

  .signed__hand {
    font-family: var(--font-hand);
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    color: var(--tape-stamp-fail);
    transform: rotate(-2deg);
  }

  /* ----------------------------------------------------------- the verdict */

  .verdict {
    position: absolute;
    left: 50%;
    top: 52%;
    z-index: 3;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 7px 16px;
    border: 3px double var(--tape-stamp-fail);
    border-radius: 3px;
    background-color: rgb(236 234 218 / 28%);
    color: var(--tape-stamp-fail);
    transform: translate(-50%, -50%) rotate(-9deg);
    pointer-events: none;
  }

  .cert[data-done='true'] .verdict {
    display: flex;
    animation: tape-stamp-over 0.45s cubic-bezier(0.2, 1.4, 0.4, 1) both;
  }

  .verdict__top {
    font-family: var(--font-display);
    font-size: 25px;
    line-height: 0.9;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .verdict__note {
    font-family: var(--font-osd);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ------------------------------------------------------- with no script */

  /*
   * Nothing here works without script, so the unscripted page gets the
   * certificate already made out: every condition in ink, every note and stamp
   * showing, the verdict across it, the signature down, and none of the dead
   * controls. It is the same trick the inlay card on reel 07 uses, and it means
   * the b-side reads as a document rather than as six broken buttons.
   */
  .only-js {
    display: none;
  }

  :global(html.js) .only-js {
    display: inline-flex;
  }

  :global(html.js) .only-static {
    display: none;
  }

  :global(html:not(.js)) .row__item {
    color: var(--tape-cert-ink);
  }

  :global(html:not(.js)) .row__note {
    opacity: 1;
  }

  :global(html:not(.js)) .row__stamp {
    display: inline-flex;
  }

  :global(html:not(.js)) .signed__rule {
    opacity: 1;
  }

  /*
   * The one thing the unscripted page does *not* get is the verdict stamp across
   * the middle of the card.
   *
   * It is translucent and it lands over two of the six conditions, which is fine
   * when you have stamped them one at a time and already read them — it is the
   * payoff for working through the form. Rendered cold it would be sitting on top
   * of two lines nobody has seen, and this page's whole job without script is to
   * read as a finished document. The signature and the tally carry the joke there
   * instead.
   */

  @media (min-width: 900px) {
    /* A certificate is a physical card; it should not grow with the panel. */
    .cert {
      max-width: 500px;
      margin: 0 auto;
    }
  }

  /* Landscape only — see the note on .screen--interval in tape.css. */
  @media (orientation: landscape) and (max-height: 700px) {
    .screen--qc {
      overflow-x: hidden;
      overflow-y: auto;
    }
  }

  @media (max-height: 700px) {
    .cert {
      gap: 5px;
      padding: 10px 12px 11px;
    }

    .cert__title {
      font-size: 23px;
    }

    .rating__mark {
      font-size: 20px;
    }

    /* The particulars are the first thing to go — the conditions are the toy. */
    .parts {
      display: none;
    }

    .row {
      padding: 1px 0;
    }

    .row__item {
      font-size: 12px;
    }

    .row__note {
      min-height: 15px;
      font-size: 14px;
    }

    .verdict__top {
      font-size: 17px;
    }

    .verdict__note {
      font-size: 10px;
    }
  }
</style>

<script>
  /* Copy via data attribute, not an import — see the note in SaltWater.astro. */
  const screen = document.querySelector<HTMLElement>('[data-qc]');

  if (screen) {
    const copy = JSON.parse(screen.dataset.copy ?? '{}') as {
      total: number;
      summaryPartial: string;
      summaryAll: string;
      signedPending: string;
      signedDone: string;
    };

    const cert = screen.querySelector<HTMLElement>('.cert')!;
    const summary = screen.querySelector<HTMLElement>('[data-qc-summary]')!;
    const signed = screen.querySelector<HTMLElement>('[data-qc-signed]')!;
    const rows = [...screen.querySelectorAll<HTMLElement>('[data-qc-row]')];

    const blip = (kind: string) =>
      document.dispatchEvent(new CustomEvent('tape:blip', { detail: kind }));

    const fill = (template: string, values: Record<string, number>) =>
      template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''));

    const verdictOf = (row: HTMLElement) =>
      row.querySelector<HTMLElement>('.row__stamp')?.dataset.verdict;

    function paint() {
      const run = rows.filter((row) => row.dataset.run === 'true');
      const pass = run.filter((row) => verdictOf(row) === 'pass').length;

      const done = run.length;
      const all = done === copy.total;
      cert.dataset.done = String(all);

      summary.textContent = all
        ? fill(copy.summaryAll, { pass, fail: done - pass })
        : fill(copy.summaryPartial, { done, total: copy.total });

      signed.textContent = all ? copy.signedDone : copy.signedPending;
    }

    /** One impression. A fail gets the heavier noise, which is the joke landing. */
    function stamp(row: HTMLElement) {
      row.dataset.run = 'true';
      blip(verdictOf(row) === 'pass' ? 'click' : 'clunk');
    }

    rows.forEach((row) => {
      row.querySelector<HTMLButtonElement>('[data-qc-run]')?.addEventListener('click', (event) => {
        event.stopPropagation();
        stamp(row);
        paint();
      });
    });

    /*
     * The stamp key takes the next unexamined condition in order rather than all
     * six at once. Going through them one at a time is what lands the three fails
     * separately — and a rubber stamp only ever makes one impression per press.
     */
    screen.querySelector<HTMLButtonElement>('[data-qc-all]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      const next = rows.find((row) => row.dataset.run !== 'true');
      if (!next) return;
      stamp(next);
      paint();
    });

    screen.querySelector<HTMLButtonElement>('[data-qc-clear]')?.addEventListener('click', (event) => {
      event.stopPropagation();
      blip('click');
      rows.forEach((row) => {
        row.dataset.run = 'false';
      });
      paint();
    });

    paint();
  }
</script>
