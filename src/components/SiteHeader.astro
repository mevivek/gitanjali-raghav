---
import { site } from '../data/site';

const initials = site.name
  .split(' ')
  .map((part) => part[0])
  .join('');
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="monogram" href={import.meta.env.BASE_URL} aria-label={`${site.name} — home`}>
      <span aria-hidden="true">{initials}</span>
    </a>

    <nav aria-label="Sections">
      <ul class="nav">
        <li><a href="#timeline-heading">Timeline</a></li>
        <li><a href="#life-heading">Life</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </nav>

    <button
      class="theme-toggle"
      type="button"
      data-theme-toggle
      aria-pressed="false"
      title="Switch between light and dark"
    >
      <span class="theme-toggle__icon" aria-hidden="true"></span>
      <span class="sr-only">Toggle dark mode</span>
    </button>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--rule);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 0.75rem;
  }

  .monogram {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    margin-inline-end: auto;
  }

  .nav {
    list-style: none;
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    font-size: var(--step--1);
    font-weight: 600;
  }

  .nav a {
    display: inline-block;
    color: var(--ink-muted);
    text-decoration: none;
    /* Roomier than it looks — these are tap targets on tablets. */
    padding-block: 0.55rem;
    border-bottom: 2px solid transparent;
  }

  .nav a:hover {
    color: var(--ink);
    border-bottom-color: var(--life);
  }

  /* The section links are a convenience, not the only way to reach the
     content — the page is a single scroll. Hidden on the narrowest screens
     to keep the bar uncluttered. */
  @media (max-width: 30rem) {
    .nav {
      display: none;
    }
  }

  .theme-toggle {
    display: grid;
    place-items: center;
    /* 44px — the minimum comfortable touch target. */
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background-color: var(--paper-raised);
    cursor: pointer;
    color: var(--ink);
  }

  .theme-toggle:hover {
    border-color: var(--ink-muted);
  }

  .theme-toggle__icon {
    width: 1rem;
    height: 1rem;
    border-radius: 999px;
    background: linear-gradient(
      135deg,
      var(--career) 0%,
      var(--career) 50%,
      var(--life) 50%,
      var(--life) 100%
    );
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

  if (toggle) {
    const root = document.documentElement;

    const currentTheme = () =>
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');

    const sync = () => toggle.setAttribute('aria-pressed', String(currentTheme() === 'dark'));

    sync();

    toggle.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* preference simply will not persist */
      }
      sync();
    });
  }
</script>
