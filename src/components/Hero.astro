---
import { site } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showEmail = !site.email.startsWith('TODO');
const showResume = Boolean(site.resume);

// Driven by site.ts rather than hardcoded, so adding a social link in one
// place adds it here too.
const links = site.socials.filter((s) => !s.href.startsWith('TODO'));
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="hero__eyebrow">
        {site.role}{' '}
        <span class="hero__at">at</span>{' '}
        <span class="hero__org">{site.organisation}</span>
      </p>

      <h1 class="hero__name">{site.name}</h1>

      <p class="hero__tagline measure">{site.tagline}</p>

      <p class="hero__location">{site.location}</p>

      <div class="hero__actions">
        {
          showEmail && (
            <a class="btn btn--primary" href={`mailto:${site.email}`}>
              {site.ctaLabel}
            </a>
          )
        }
        {
          links.map((link) => (
            <a class="btn" href={link.href} rel="me noopener noreferrer" target="_blank">
              {link.label}
            </a>
          ))
        }
        {
          showResume && (
            <a class="btn" href={`${base}/${site.resume}`} download>
              Download CV
            </a>
          )
        }
      </div>
    </div>

    {/*
      Two strands — one per lane — running down and converging on her
      portrait, which is the point the whole site is making. The SVG is
      decorative and hidden from assistive tech; the photograph is not.
    */}
    <div class="hero__mark">
      <svg class="hero__strands" viewBox="0 0 200 150" aria-hidden="true" focusable="false">
        {/*
          pathLength="1" normalises each path to a length of 1 regardless of
          its real geometry, so the draw animation below can use exact values
          instead of a guessed dash length that under- or overshoots.
        */}
        <path class="strand strand--career" pathLength="1" d="M50 0 C50 70, 100 80, 100 150" />
        <path class="strand strand--life" pathLength="1" d="M150 0 C150 70, 100 80, 100 150" />
      </svg>

      <img
        class="hero__portrait"
        src={`${base}/img/portrait.jpg`}
        alt={site.name}
        width="320"
        height="320"
        fetchpriority="high"
        decoding="async"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3.5rem, 2rem + 7vw, 7rem) var(--section-gap);
    border-bottom: 1px solid var(--rule);
    background:
      radial-gradient(
        ellipse 80% 60% at 15% 0%,
        color-mix(in oklab, var(--life) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(
        ellipse 70% 55% at 85% 10%,
        color-mix(in oklab, var(--career) 11%, transparent),
        transparent 70%
      );
  }

  .hero__inner {
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  .hero__eyebrow {
    margin: 0 0 1rem;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--career-text);
    letter-spacing: 0.01em;
  }

  .hero__at {
    color: var(--ink-muted);
    font-weight: 400;
  }

  .hero__org {
    color: var(--career-text);
  }

  .hero__name {
    margin: 0;
    font-size: var(--step-6);
    font-weight: 600;
    letter-spacing: -0.02em;
    /* Fraunces' WONK axis dialled up — this is the one place on the page
       where the type is allowed to have a bit of swagger. */
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 100;
  }

  .hero__tagline {
    margin: 1.25rem 0 0;
    font-size: var(--step-2);
    color: var(--ink-muted);
    line-height: 1.4;
  }

  .hero__location {
    margin: 1rem 0 0;
    font-size: var(--step--1);
    color: var(--ink-muted);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 600;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background-color: var(--paper-raised);
    color: var(--ink);
    padding: 0.6rem 1.35rem;
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      background-color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
    border-color: var(--ink-muted);
  }

  .btn--primary {
    background-color: var(--career);
    border-color: var(--career);
    /* --paper is the light surface in light mode and the dark one in dark
       mode, which is exactly the contrast needed against --career either
       way. */
    color: var(--paper);
  }

  .btn--primary:hover {
    border-color: var(--career);
  }

  .hero__mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Portrait first on small screens; the strands only make sense once
       there is room to draw them. */
    order: -1;
  }

  .hero__strands {
    display: none;
    width: 10rem;
    /* Overlaps the portrait's top edge by a hair so the strokes appear to
       run into it rather than stop short. */
    margin-bottom: -2px;
  }

  .strand {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
  }

  .strand--career {
    stroke: var(--career);
  }

  .strand--life {
    stroke: var(--life);
  }

  .hero__portrait {
    width: 5.5rem;
    height: 5.5rem;
    border-radius: 999px;
    object-fit: cover;
    /* The source is only 320px, so it is never displayed larger than that
       at 2x. Sized to stay sharp rather than to fill space. */
    border: 3px solid var(--paper-raised);
    box-shadow: 0 2px 12px rgb(0 0 0 / 12%);
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: 3rem;
    }

    .hero__mark {
      order: 0;
      justify-self: end;
    }

    .hero__strands {
      display: block;
    }

    .hero__portrait {
      width: 9.5rem;
      height: 9.5rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .strand {
      /* Paths carry pathLength="1", so 1 is exactly one full stroke. */
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      animation: draw 1.1s 0.15s ease-out forwards;
    }

    @keyframes draw {
      to {
        stroke-dashoffset: 0;
      }
    }
  }
</style>
