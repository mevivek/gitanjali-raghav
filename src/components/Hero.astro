---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import portrait from '../assets/photos/portrait.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const showEmail = Boolean(site.email);
const showResume = Boolean(site.resume);
---

<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__text">
      <p class="hero__hi">Hi — I'm</p>

      <h1 class="hero__name">
        <span class="hero__first">{site.firstName}</span>
        <span class="hero__last">Raghav</span>
      </h1>

      <p class="hero__tagline">{site.tagline}</p>

      <ul class="facts">
        {
          site.facts.map((fact) => (
            <li class="fact">
              <span class="fact__icon" aria-hidden="true">
                {fact.icon}
              </span>
              {fact.text}
            </li>
          ))
        }
      </ul>

      <div class="hero__actions">
        {
          showEmail && (
            <a class="btn btn--primary" href={`mailto:${site.email}`}>
              {site.ctaLabel}
            </a>
          )
        }
        {
          site.socials.map((link) => (
            <a class="btn" href={link.href} rel="me noopener noreferrer" target="_blank">
              {link.label}
            </a>
          ))
        }
        {
          showResume && (
            <a class="btn" href={`${base}/${site.resume}`} download>
              CV
            </a>
          )
        }
      </div>
    </div>

    <div class="hero__portrait">
      {/* The source is only 320px square, so 320 is the ceiling — asking
          for more would just upscale a small image. */}
      <Image
        src={portrait}
        width={320}
        widths={[160, 320]}
        sizes="(min-width: 60rem) 220px, 150px"
        alt={site.name}
        loading="eager"
        fetchpriority="high"
      />
      <span class="hero__blob" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 5.5rem) var(--section-gap);
    background:
      radial-gradient(
        ellipse 70% 55% at 12% 0%,
        color-mix(in oklab, var(--life) 14%, transparent),
        transparent 68%
      ),
      radial-gradient(
        ellipse 60% 50% at 88% 8%,
        color-mix(in oklab, var(--career) 14%, transparent),
        transparent 68%
      );
  }

  .hero__inner {
    display: grid;
    gap: 2rem;
    justify-items: start;
  }

  .hero__hi {
    margin: 0 0 0.35rem;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--life-text);
  }

  .hero__name {
    margin: 0;
    font-size: var(--step-6);
    line-height: 0.95;
    letter-spacing: -0.03em;
    font-variation-settings: 'SOFT' 40, 'WONK' 1, 'opsz' 100;
  }

  .hero__first,
  .hero__last {
    display: block;
  }

  /* The surname sits back a little so the eye lands on the first name. */
  .hero__last {
    color: var(--ink-muted);
    margin-inline-start: 0.08em;
  }

  .hero__tagline {
    margin: 1.35rem 0 0;
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.35;
    color: var(--ink);
    font-family: var(--font-display);
  }

  .facts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
  }

  .fact {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--paper-raised);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.4rem 0.9rem;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .fact__icon {
    font-size: 1.05em;
    line-height: 1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid var(--ink);
    background-color: transparent;
    color: var(--ink);
    padding: 0.6rem 1.35rem;
    font-size: var(--step-0);
    font-weight: 600;
    text-decoration: none;
    transition:
      transform 0.18s ease,
      background-color 0.18s ease,
      color 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px) rotate(-1deg);
    background-color: var(--ink);
    color: var(--paper);
  }

  .btn--primary {
    background-color: var(--life);
    border-color: var(--life);
    color: var(--paper);
  }

  .btn--primary:hover {
    background-color: var(--life-text);
    border-color: var(--life-text);
    color: var(--paper);
  }

  /* ---- portrait ---------------------------------------------------- */

  .hero__portrait {
    position: relative;
    order: -1;
    width: 9.4rem;
  }

  .hero__portrait img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 42% 58% 46% 54% / 52% 44% 56% 48%;
    border: 4px solid var(--paper-raised);
    box-shadow: 0 8px 26px rgb(0 0 0 / 14%);
  }

  /* A soft shape peeking out behind the portrait — the one bit of pure
     decoration on the page. */
  .hero__blob {
    position: absolute;
    inset: -8% -8% -8% -8%;
    background: linear-gradient(140deg, var(--life), var(--career));
    border-radius: 54% 46% 58% 42% / 46% 56% 44% 54%;
    opacity: 0.25;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__blob {
      animation: drift 14s ease-in-out infinite alternate;
    }

    @keyframes drift {
      to {
        border-radius: 44% 56% 42% 58% / 58% 42% 56% 44%;
        transform: rotate(8deg) scale(1.04);
      }
    }
  }

  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 15rem;
      gap: 4rem;
      align-items: center;
    }

    .hero__portrait {
      order: 0;
      width: 100%;
      justify-self: end;
    }
  }
</style>
