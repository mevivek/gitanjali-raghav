---
import { Image } from 'astro:assets';
import { gallery } from '../data/gallery';
---

<section class="gallery" aria-labelledby="gallery-heading">
  <div class="wrap">
    <header class="gallery__header">
      <h2 id="gallery-heading">
        Out and about
        <span class="gallery__scribble" aria-hidden="true">
          <svg viewBox="0 0 200 12" preserveAspectRatio="none" focusable="false">
            <path d="M2 8 C40 2, 70 11, 105 5 S170 2, 198 7" />
          </svg>
        </span>
      </h2>
      <p>Coastlines, courtyards, and the occasional excellent outfit.</p>
    </header>

    {/*
      A column layout rather than a grid: photos are different heights and
      masonry lets them keep their real proportions instead of being cropped
      to a uniform box.
    */}
    <ul class="wall">
      {
        gallery.map((photo, i) => (
          <li class="snap">
            <figure>
              {/*
                Served at the source's full 1080px at the top of the srcset,
                so a high-density screen gets every pixel that exists. The
                smaller widths are what an ordinary display actually
                downloads — the browser picks one from `sizes`, it does not
                fetch them all.
              */}
              <Image
                src={photo.src}
                width={1080}
                widths={[400, 720, 1080]}
                sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 30vw, 44vw"
                alt={photo.alt}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <figcaption>
                {photo.label && <span class="cap__label">{photo.label}</span>}
                <span class="cap__date">{photo.date}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .gallery {
    padding-block: var(--section-gap);
    background-color: var(--paper-sunk);
    border-block: 1px solid var(--rule);
  }

  .gallery__header {
    margin-bottom: 2.5rem;
  }

  .gallery__header h2 {
    position: relative;
    display: inline-block;
    font-size: var(--step-5);
    margin: 0 0 0.35rem;
  }

  /* Hand-drawn underline, in the life colour. */
  .gallery__scribble {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.35em;
    height: 0.4em;
  }

  .gallery__scribble svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .gallery__scribble path {
    fill: none;
    stroke: var(--life);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .gallery__header p {
    margin: 0.75rem 0 0;
    color: var(--ink-muted);
    font-size: var(--step-1);
    font-family: var(--font-display);
    font-style: italic;
  }

  .wall {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(0.75rem, 0.4rem + 1.5vw, 1.5rem);
  }

  .snap {
    break-inside: avoid;
    margin-bottom: clamp(1rem, 0.6rem + 1.8vw, 1.75rem);
  }

  figure {
    margin: 0;
    background-color: var(--paper-raised);
    padding: 0.5rem 0.5rem 0.25rem;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 8%),
      0 6px 16px rgb(0 0 0 / 8%);
    /* Cycling tilt, so the wall reads as pinned up rather than gridded.
       nth-child rather than a calc() on --i: CSS mod() is still too new to
       rely on, and four rules cover the cycle just as well. */
    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.3, 1),
      box-shadow 0.35s ease;
  }

  .snap:nth-child(4n + 1) figure {
    transform: rotate(-1.4deg);
  }

  .snap:nth-child(4n + 2) figure {
    transform: rotate(1.1deg);
  }

  .snap:nth-child(4n + 3) figure {
    transform: rotate(-0.7deg);
  }

  .snap:nth-child(4n) figure {
    transform: rotate(1.6deg);
  }

  figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 1px;
  }

  figcaption {
    text-align: center;
    padding: 0.5rem 0.2rem 0.3rem;
    line-height: 1.3;
  }

  /*
   * Label and date are separate blocks rather than one string. At two
   * columns on a phone a card is only ~155px wide, and "On the bullet —
   * January 2020" wrapped to three ragged lines. Splitting them makes the
   * break intentional: name on one line, date on the next.
   */
  .cap__label {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step--1);
    color: var(--ink);
    text-wrap: balance;
  }

  .cap__date {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.72rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  @media (hover: hover) {
    .snap:hover figure,
    .snap:focus-within figure {
      transform: rotate(0deg) translateY(-6px) scale(1.02);
      box-shadow:
        0 2px 4px rgb(0 0 0 / 10%),
        0 14px 30px rgb(0 0 0 / 16%);
    }
  }

  @media (min-width: 40rem) {
    .wall {
      columns: 3;
    }
  }

  @media (min-width: 64rem) {
    .wall {
      columns: 4;
    }
  }
</style>
