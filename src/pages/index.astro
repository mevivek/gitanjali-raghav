---
import Base from '../layouts/Base.astro';
import TitleCard from '../components/tape/TitleCard.astro';
import SaltWater from '../components/tape/reels/SaltWater.astro';
import TwoWheels from '../components/tape/reels/TwoWheels.astro';
import AnyExcuse from '../components/tape/reels/AnyExcuse.astro';
import TakeFour from '../components/tape/reels/TakeFour.astro';
import ColdAir from '../components/tape/reels/ColdAir.astro';
import Playback from '../components/tape/reels/Playback.astro';
import SideA from '../components/tape/reels/SideA.astro';
import IntervalCard from '../components/tape/IntervalCard.astro';
import QualityCheck from '../components/tape/QualityCheck.astro';
import EndCredits from '../components/tape/EndCredits.astro';
import TapeBoot from '../components/tape/TapeBoot.astro';
import TapeChrome from '../components/tape/TapeChrome.astro';
import TapeGrain from '../components/tape/TapeGrain.astro';
import TapePrefetch from '../components/tape/TapePrefetch.astro';
import { reelCount, screenCount } from '../data/tape';

/*
 * Eleven screens on one strip: the title card, seven reels, the interval, the
 * interval's b-side, the end credits. The order is the whole argument of the
 * site — the photographs come first and the job is an interval near the end,
 * not a section at the top.
 *
 * The reels are seven separate components rather than seven passes over one,
 * because each is a different toy: you touch the water, hold the throttle, pick
 * the occasion, roll the take, drag the temperature down, tap on the beat, play
 * a line. They share a skeleton (src/styles/tape.css) and nothing else.
 *
 * Each screen's `id` is its own name — `#cold-air`, not `#screen-5` — so the
 * play, resume, b-side and rewind links are real links, a single reel can be
 * linked to from outside, and the URL says where you are.
 */
const intervalIndex = reelCount + 1;
const bsideIndex = reelCount + 2;
const creditsIndex = reelCount + 3;
---

<Base>
  <div class="tape" id="tape">
    <div
      class="tape__track"
      data-tape-track
      tabindex="0"
      role="region"
      aria-label={`Home video — ${screenCount} screens. Scroll, swipe or use the arrow keys.`}
    >
      <TitleCard index={0} />

      <SaltWater index={1} />
      <TwoWheels index={2} />
      <AnyExcuse index={3} />
      <TakeFour index={4} />
      <ColdAir index={5} />
      <Playback index={6} />
      <SideA index={7} />

      <IntervalCard index={intervalIndex} />
      <QualityCheck index={bsideIndex} />
      <EndCredits index={creditsIndex} />
    </div>

    <TapeChrome />
    <TapeGrain />

    {/* The tracking noise before the picture settles. Clears itself. */}
    <TapeBoot />
  </div>

  {/* Behaviour only, renders nothing — warms the photographs after load. */}
  <TapePrefetch />
</Base>

<script>
  /*
   * Everything below is an upgrade to a tape that already works.
   *
   * The strip is a native scroll container with CSS scroll snapping, so
   * without a line of this the site still swipes between reels, scrolls with
   * a wheel, takes arrow keys and Page Up/Down once focused, and moves when
   * you click play, resume tape or rewind. What script adds is knowing *which*
   * reel is in front — which is what the dimming, the progress segments, the
   * running timecode, the credits roll, reel 06's beat and the interval's clock
   * all need — plus the two transport keys, drag-to-scrub on a wide screen, and
   * keeping the URL pointed at the reel you are looking at.
   */
  const track = document.querySelector<HTMLElement>('[data-tape-track]');
  const screens = [...document.querySelectorAll<HTMLElement>('[data-screen]')];

  if (track && screens.length) {
    const segs = [...document.querySelectorAll<HTMLElement>('[data-seg]')];
    const counter = document.querySelector<HTMLElement>('[data-tape-counter]');

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    /** True while the tape lies sideways — matches the 900px break in CSS. */
    const wide = window.matchMedia('(min-width: 900px)');

    /*
     * Where the counter says the tape is, screen by screen. Read off the
     * counter's own data attribute rather than recomputed here: it used to be
     * the same arithmetic written twice, which is one copy too many, and the
     * numbers now come from the timecodes each screen prints on itself. Not
     * imported, because importing src/data/tape.ts would pull fifteen
     * photographs into this bundle's module graph.
     */
    let positions: string[] = [];
    try {
      positions = JSON.parse(counter?.dataset.tapePositions ?? '[]');
    } catch {
      positions = [];
    }

    let current = 0;

    function paint(i: number) {
      if (i === current) return;
      current = i;

      screens.forEach((screen, n) => {
        screen.dataset.active = n === i ? 'true' : 'false';
        // How far away this reel is, and in which direction. The photographs
        // drift against their frames by 10px a screen.
        screen.style.setProperty('--dist', String(n - i));
      });

      // Both indicators are in the DOM — one per orientation — so every
      // segment is updated and CSS decides which set is visible.
      segs.forEach((seg) => {
        const n = Number(seg.dataset.seg);
        seg.dataset.state = n === i ? 'now' : n < i ? 'seen' : 'todo';
      });

      if (counter && positions[i]) counter.textContent = positions[i];
    }

    /*
     * Which screen is in front. Comparing intersection ratios rather than
     * measuring scroll offsets keeps one code path for both orientations, and
     * stays correct through a snap, a drag and a fling alike.
     */
    const ratios = new Map<Element, number>();

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) ratios.set(entry.target, entry.intersectionRatio);

        let best = 0;
        let bestRatio = -1;
        screens.forEach((screen, n) => {
          const ratio = ratios.get(screen) ?? 0;
          if (ratio > bestRatio) {
            bestRatio = ratio;
            best = n;
          }
        });

        paint(best);
      },
      /*
       * The viewport, not the track. Which element does the scrolling changes
       * with the breakpoint — the document on a phone, the track above 900px —
       * and an observer's root cannot be changed after it is built. Measuring
       * against the viewport is correct either way: a screen scrolled past
       * vertically and a screen slid off sideways are both simply not on screen.
       */
      { root: null, threshold: [0, 0.25, 0.5, 0.75, 1] },
    );

    screens.forEach((screen) => observer.observe(screen));

    /* ------------------------------------------------------------- moving */

    /**
     * Ask the deck for a noise. It answers only if the visitor has turned sound
     * on; if TapeChrome's script never ran, nobody is listening and nothing
     * happens. See the note at the foot of TapeChrome.astro.
     */
    const blip = (kind: string) =>
      document.dispatchEvent(new CustomEvent('tape:blip', { detail: kind }));

    function go(n: number, instant = false, noise = 'clunk') {
      const i = Math.max(0, Math.min(screens.length - 1, n));
      const target = screens[i];
      // `scrollTo`'s smooth behaviour is set in JS, so it ignores the CSS
      // reduced-motion kill-switch and has to be checked here.
      const behavior: ScrollBehavior = instant || reduceMotion.matches ? 'auto' : 'smooth';

      /*
       * The transport's clunk, and only for a move somebody asked for. It is
       * deliberately not fired from the observer: a wheel-flick or a fling
       * crosses several screens, and a deck does not clunk eleven times.
       * Restoring the layout after a resize is not a move either.
       */
      if (!instant && i !== current) blip(noise);

      if (wide.matches) {
        // The track scrolls sideways; centre the panel in it.
        track!.scrollTo({
          left: target.offsetLeft - (track!.clientWidth - target.clientWidth) / 2,
          behavior,
        });
      } else {
        /*
         * The document scrolls. Measured from the viewport rather than read off
         * `offsetTop`, which is relative to whichever ancestor happens to be
         * positioned and would be wrong the moment the layout around it changes.
         */
        const top = target.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top, behavior });
      }

      /*
       * Point the URL at the reel. `replaceState` rather than `pushState`: the
       * back button should leave the tape, not walk back through eleven screens
       * of it. Screen 0 drops the fragment entirely, so the tape's own address
       * stays clean.
       */
      try {
        const at = i === 0 ? location.pathname + location.search : `#${target.id}`;
        history.replaceState(null, '', at);
      } catch {
        /* file:// and a few embedded webviews refuse this; nothing depends on it */
      }
    }

    document.querySelector('[data-tape-prev]')?.addEventListener('click', () => go(current - 1));
    document.querySelector('[data-tape-next]')?.addEventListener('click', () => go(current + 1));

    // The play, resume, b-side and rewind anchors. Intercepted so they glide
    // rather than jump; if anything here throws, the href still does the job.
    // `data-tape-blip` lets one of them ask for a different noise — the rewind
    // sticker on the credits wants the sound of the tape spooling back.
    document.querySelectorAll<HTMLAnchorElement>('[data-tape-go]').forEach((link) => {
      link.addEventListener('click', (event) => {
        event.preventDefault();
        go(Number(link.dataset.tapeGo), false, link.dataset.tapeBlip ?? 'clunk');
      });
    });

    /*
     * Arrow keys move a whole screen instead of the browser's default nudge.
     * Only while the tape itself has focus, so a key press meant for a link
     * or a button is left alone.
     */
    track.addEventListener('keydown', (event) => {
      if (event.target !== track) return;

      const forward = ['ArrowRight', 'ArrowDown', 'PageDown'];
      const back = ['ArrowLeft', 'ArrowUp', 'PageUp'];

      if (forward.includes(event.key)) {
        event.preventDefault();
        go(current + 1);
      } else if (back.includes(event.key)) {
        event.preventDefault();
        go(current - 1);
      } else if (event.key === 'Home') {
        event.preventDefault();
        go(0);
      } else if (event.key === 'End') {
        event.preventDefault();
        go(screens.length - 1);
      }
    });

    /* ----------------------------------------------------- drag the tape */

    /*
     * Wide only, where the design's hint says to drag. Snapping is suspended
     * for the duration — with `scroll-snap-type` still on, every pixel of
     * movement fights to settle back — then the release picks the nearest
     * screen and glides to it.
     */
    let from: { x: number; scroll: number } | null = null;

    track.addEventListener('pointerdown', (event) => {
      if (!wide.matches || event.button !== 0) return;
      // Let a click on something clickable be a click, and a drag on one of a
      // reel's own controls — the throttle, the temperature dial — belong to
      // that control rather than scrubbing the tape out from under it.
      if ((event.target as HTMLElement).closest('a, button, input, [data-nodrag]')) return;

      from = { x: event.clientX, scroll: track.scrollLeft };
      track.dataset.dragging = 'true';
      track.setPointerCapture(event.pointerId);
    });

    track.addEventListener('pointermove', (event) => {
      if (!from) return;
      track.scrollLeft = from.scroll - (event.clientX - from.x);
    });

    function endDrag() {
      if (!from) return;
      from = null;
      delete track!.dataset.dragging;

      // Nearest screen by centre, then let `go` do the easing.
      const centre = track!.scrollLeft + track!.clientWidth / 2;
      let nearest = 0;
      let shortest = Infinity;
      screens.forEach((screen, n) => {
        const distance = Math.abs(screen.offsetLeft + screen.clientWidth / 2 - centre);
        if (distance < shortest) {
          shortest = distance;
          nearest = n;
        }
      });

      go(nearest);
    }

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    /*
     * Rotating a phone, or crossing the 900px break, changes the scroll axis
     * out from under us — the tape would be left between two reels. Put the
     * one that was in front back in front.
     */
    const restore = () => {
      const i = current;
      // Let the new layout settle before measuring it.
      requestAnimationFrame(() => {
        current = -1;
        go(i, true);
        paint(i);
      });
    };

    wide.addEventListener('change', restore);
    window.addEventListener('orientationchange', restore);

    /* ------------------------------------------------- the visible height */

    /*
     * Measures what the visitor can actually see and hands it to the CSS, then
     * puts the reel that was in front back in front.
     *
     * Both halves are needed. On iOS Safari with `viewport-fit=cover`, `100dvh`
     * and the genuinely visible area disagree, so screens came out shorter than
     * the window and left a sliver of the previous reel above and the next one
     * below. `visualViewport.height` is by definition the visible area, so it
     * cannot disagree.
     *
     * And a layout change moves every snap position at once: eleven screens that
     * each grew by the height of a collapsing toolbar put the tape N × that
     * far out, wrong by more the further along you are. Chromium re-snaps after
     * a resize; Safari does not, so this does it by hand — instantly, because a
     * smooth correction would fight the scroll that caused it.
     */
    const viewport = window.visualViewport;
    let lastHeight = 0;
    let settle: number | null = null;

    function measure() {
      const height = Math.round(viewport ? viewport.height : window.innerHeight);
      // The collapse animates, firing this continuously; only a real change is
      // worth reflowing eleven full-screen sections for.
      if (!height || Math.abs(height - lastHeight) < 2) return;
      lastHeight = height;

      document.documentElement.style.setProperty('--screen-h', `${height}px`);
      restore();
    }

    const remeasure = () => {
      if (settle !== null) clearTimeout(settle);
      settle = window.setTimeout(() => {
        settle = null;
        measure();
      }, 150);
    };

    /* ---------------------------------------------------------- arriving */

    /*
     * Where the tape opens: screen 0, or the reel the URL names.
     *
     * This has to be settled *before* the first `measure()`, not after. The
     * first measurement always ends in `restore()`, which schedules a jump back
     * to whichever screen it believed was in front — so landing on `#cold-air`
     * first and measuring second put the tape on the right reel and then a
     * frame later slid it back to the title card.
     */
    let landing = 0;
    if (location.hash) {
      const named = screens.findIndex((screen) => `#${screen.id}` === location.hash);
      if (named > 0) landing = named;
    }

    // The server marks screen 0 active, but the parallax offsets and the
    // segment states still need setting — and if the URL named a reel, that is
    // the one that is really in front.
    current = -1;
    paint(landing);

    measure();
    viewport?.addEventListener('resize', remeasure);
    // Fallback for anything without visualViewport, and a second chance if the
    // toolbar settles without firing one.
    window.addEventListener('resize', remeasure);

    /*
     * The browser has already jumped roughly to a named reel from the fragment,
     * but on a wide screen "roughly" is the left edge of the panel rather than
     * its centre. Redone properly, instantly, and without a noise — nobody
     * pressed anything.
     */
    if (landing > 0) go(landing, true);
  }
</script>
