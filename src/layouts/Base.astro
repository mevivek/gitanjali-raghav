---
import '../styles/global.css';
import { site } from '../data/site';
import { look } from '../data/tape';
import { scanContent } from '../../scripts/scan.mjs';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

/*
 * The page asks search engines to skip it until two things are true: no
 * placeholder text remains, and she has actually seen the site and approved
 * it (`approved` in site.ts). Being factually complete is not the same as
 * being wanted in search results, and that second call is hers, not ours.
 */
const { placeholders } = scanContent();
const isDraft = placeholders.length > 0 || !site.approved;

// Astro.site + base are set in astro.config.mjs; this yields absolute URLs
// for the social tags, which require them.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(`${import.meta.env.BASE_URL}/og.png`.replace(/\/+/g, '/'), Astro.site);
---

<!doctype html>
<html lang="en" dir="ltr" data-grade={look.grade} data-osd={look.osd ? 'on' : 'off'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isDraft && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {/* The tape has no light mode, so the browser chrome should not have one. */}
    <meta name="theme-color" content="#08040d" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />

    {/*
      Marks that scripting is available. The transport buttons need it to do
      anything — the tape itself is a scroll container and moves without
      them — so they are hidden until this class lands. Inline and tiny so it
      runs before first paint and they never flash in and out.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#tape">Skip to the tape</a>
    <slot />
  </body>
</html>
