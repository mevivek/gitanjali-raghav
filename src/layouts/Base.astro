---
import '../styles/global.css';
import { ASSET_VERSION, site } from '../data/site';
import { look } from '../data/tape';
import { scanContent } from '../../scripts/scan.mjs';

interface Props {
  title?: string;
  description?: string;
  /**
   * Forces `noindex` regardless of the publish gate. The 404 sets it: a "tape not
   * found" page has nothing worth indexing even once the tape itself is public,
   * and search engines that do index one tend to report it as a soft 404.
   */
  noindex?: boolean;
}

const { title = site.title, description = site.description, noindex = false } = Astro.props;

/*
 * The page asks search engines to skip it until two things are true: no
 * placeholder text remains, and she has actually seen the site and approved
 * it (`approved` in site.ts). Being factually complete is not the same as
 * being wanted in search results, and that second call is hers, not ours.
 */
const { placeholders } = scanContent();
const isDraft = noindex || placeholders.length > 0 || !site.approved;

// Astro.site + base are set in astro.config.mjs; this yields absolute URLs
// for the social tags, which require them.
const canonical = new URL(Astro.url.pathname, Astro.site);

/** Path under the site's base, e.g. `/gitanjali-raghav/og.jpg`. */
const path = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, '/');

/**
 * Absolute, origin and all. Only for tags that genuinely require it: a social
 * scraper fetching `og:image` has no page to resolve a relative path against.
 */
const asset = (file: string) => new URL(path(file), Astro.site);

/*
 * The cache-buster now lives in src/data/site.ts, because EndCredits.astro needs
 * the same number for the video and two copies of it would eventually disagree.
 * The reasoning — Cloudflare's four-hour cache on fixed-name files in public/, and
 * why og.jpg matters most — is in the comment there.
 */

/**
 * The share image. A JPEG, not a PNG: it is mostly a photograph and a
 * gradient, and the same picture as a PNG was 896KB against 86KB here — over
 * the size at which WhatsApp in particular quietly declines to render a
 * preview at all. Generated from scripts/og-template.html.
 *
 * Absolute, because a scraper has no page to resolve a relative path against.
 */
const ogImage = `${asset('og.jpg')}?v=${ASSET_VERSION}`;

/*
 * Icons are deliberately paths, not absolute URLs. An icon is fetched by the
 * browser that already has the page, so it should resolve against whatever
 * origin served it — hard-coding `Astro.site` made `npm run preview` reach
 * across to production for its favicon, and would break the moment this is
 * served from anywhere else.
 */
const icon = (file: string) => `${path(file)}?v=${ASSET_VERSION}`;
---

<!doctype html>
<html lang="en" dir="ltr" data-grade={look.grade} data-osd={look.osd ? 'on' : 'off'}>
  <head>
    <meta charset="utf-8" />
    {/*
      `viewport-fit=cover` lets the page paint all the way into the physical
      edges of the screen — behind the notch, under the rounded corners, past
      the home indicator — instead of being letterboxed inside the safe area.
      A full-bleed photograph should reach the edge of the glass.

      It puts the onus on the CSS to keep anything you have to read or press out
      from under that furniture, which is what the `env(safe-area-inset-*)`
      padding in tape.css does.
    */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isDraft && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/*
      Dimensions matter more than they look: without them a scraper has to
      fetch and measure the image before it can decide on a layout, and
      several will fall back to a small square card — or no image — rather
      than wait. `og:image:alt` is read aloud by screen readers on the
      platforms that support it.
    */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {/*
      Describes public/og.jpg in words, so it has to be changed whenever that
      image is redrawn — it used to say "a VHS cassette labelled 'geetanjali
      raghav'", which stopped being true when the title card became a poster.
    */}
    <meta
      property="og:image:alt"
      content="A film poster: Geetanjali Raghav close up in red and gold, beside the words 'No plot, just good footage'"
    />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Twitter falls back to og:image, but is happier told outright. */}
    <meta name="twitter:image" content={ogImage} />

    {/* The tape has no light mode, so the browser chrome should not have one. */}
    <meta name="theme-color" content="#08040d" />
    <meta name="color-scheme" content="dark" />

    {/*
      SVG for browsers, PNG for everything that cannot read one — iOS home
      screens and share sheets, and a few link-preview scrapers that reach for
      an apple-touch-icon when a page has no other raster icon.
    */}
    <link rel="icon" href={icon('favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={icon('apple-touch-icon.png')} />

    {/*
      Marks that scripting is available. The transport buttons need it to do
      anything — the tape itself is a scroll container and moves without
      them — so they are hidden until this class lands. Inline and tiny so it
      runs before first paint and they never flash in and out.

      `deep` marks arriving at a named reel, which means skipping the cold open.
      It has to be decided here, before first paint, or the opening would flash
      up for a frame on its way out. See TapeBoot.astro.
    */}
    <script is:inline>
      document.documentElement.classList.add('js');
      if (location.hash) document.documentElement.classList.add('deep');
    </script>
  </head>

  <body>
    <a class="skip-link" href="#tape">Skip to the tape</a>
    <slot />
  </body>
</html>
